---
// Slide 01 — "Catch Up With Friends". The Feed screen.
//
// Screen and breakouts are both real DOM (see ./screens/), so the two pieces
// that fly out are literally the same components the screen renders — the
// screen just draws them hollow, leaving the gap they return to. Nothing here
// declares a home position: each piece names its slot and the frame measures
// it, so moving something in the screen moves its landing spot with it.
import WuzyFrame from './WuzyFrame.astro';
import FeedScreen from './screens/FeedScreen.astro';
import FeedCard from './screens/FeedCard.astro';
import Poster from './screens/Poster.astro';
import NavBar from './screens/NavBar.astro';
import Icon from './screens/Icon.astro';

const img = (f: string) => `/wuzy/img/feed/${f}`;

// Placement while floating: --x/--y are the piece's centre as a percentage of
// the frame box, so outside 0–100 hangs it off the edge. --z is depth for the
// pointer tilt. data-parallax is how far it drifts before it seats.
const card = {
  style: '--x:-5%;--y:34%;--z:26px;',
  f: '--amp:11px;--dur:6.2s;--delay:0s;--tilt:1.4deg',
};
const poster = {
  style: '--x:101%;--y:60%;--z:26px;',
  f: '--amp:10px;--dur:5.5s;--delay:0.6s;--tilt:2deg',
};
---

<WuzyFrame wellLabel="Feed screen, scrollable" screenW={360}>
  <FeedScreen slot="screen" hollow={['runclub', 'p-dutchgp']} />

  <!-- Bottom nav. Chrome, not content: it stays put while the screen scrolls,
       seated against the well's own lower edge rather than the y it happened
       to land on in a long screenshot. -->
  <div slot="chrome" class="wz-pin wz-pin--bottom wz-out--dom" style="--pl:50%" aria-hidden="true">
    <NavBar />
  </div>

  <!-- Compose. Chrome as well, so it neither scrolls away with the rail it
       used to sit on nor gets painted over by a poster flying home into it. -->
  <div slot="chrome" class="wz-pin wz-pin--fab wz-out--dom" aria-hidden="true">
    <div class="wz-chrome grid size-46 place-items-center rounded-full text-white">
      <Icon name="plus" class="size-22" />
    </div>
  </div>

  <Fragment slot="outs">
    <div
      class="wz-out wz-out--dom"
      style={card.style}
      data-home="runclub"
      data-x="-5"
      data-y="34"
      data-parallax="-24"
      role="img"
      aria-label="Feed post from New york run club"
    >
      <div class="wz-out-e" style="--in-delay:0ms">
        <div class="wz-out-f" style={card.f}>
          <FeedCard
              name="New york run club"
              place="new jersey"
              avatar={img('runclub-avatar.jpg')}
              photo={img('runclub-photo.jpg')}
            />
        </div>
      </div>
    </div>

    <div
      class="wz-out wz-out--dom"
      style={poster.style}
      data-home="p-dutchgp"
      data-x="101"
      data-y="60"
      data-parallax="20"
      role="img"
      aria-label="Recommended event, dutch gp"
    >
      <div class="wz-out-e" style="--in-delay:130ms">
        <div class="wz-out-f" style={poster.f}>
          <Poster
              name="dutch gp"
              img={img('poster-dutchgp.jpg')}
              avatar={img('dutchgp-avatar.jpg')}
            />
        </div>
      </div>
    </div>
  </Fragment>
</WuzyFrame>
