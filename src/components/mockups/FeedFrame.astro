---
// Slide 01 — "Catch Up With Friends". The Feed screen.
//
// The two pieces that fly out are the same components the screen renders, from
// the same content — the screen just draws them hollow, leaving the gap they
// return to. Nothing here declares a home position: each piece names its slot
// and the frame measures it.
//
// Composition: a symmetric pair, one off each edge at mid height.
import WuzyFrame from './WuzyFrame.astro';
import FeedScreen from './screens/FeedScreen.astro';
import FeedCard from './screens/FeedCard.astro';
import Poster from './screens/Poster.astro';
import NavBar from './screens/NavBar.astro';
import PlusButton from './screens/PlusButton.astro';
import { posts, posters, byName } from './screens/content';
import { float } from './screens/motion';

const lifted = ['runclub', 'p-dutchgp'];

const card = float({ x: -5, y: 34, parallax: -24, speed: 'heavy', tilt: 1.5 }, 0);
const poster = float({ x: 101, y: 60, parallax: 20, speed: 'mid', tilt: 2 }, 1);

const runclub = byName(posts, 'runclub');
const dutchgp = byName(posters, 'p-dutchgp');
---

<WuzyFrame wellLabel="Feed screen, scrollable">
  <FeedScreen slot="screen" hollow={lifted} />

  <!-- Bottom nav. Chrome, not content: it stays put while the screen scrolls,
       seated against the well's own lower edge rather than the y it happened
       to land on in a long screenshot. -->
  <div slot="chrome" class="wz-pin wz-pin--bottom" aria-hidden="true">
    <NavBar />
  </div>

  <!-- Compose, in the corner every screen keeps it. Static here: it does not
       scroll away, and nothing can paint over it. -->
  <div slot="chrome" class="wz-pin wz-pin--compose" aria-hidden="true">
    <PlusButton />
  </div>

  <Fragment slot="outs">
    <div
      class="wz-out"
      style={card.style}
      data-home="runclub"
      {...card.data}
      role="img"
      aria-label={`Feed post from ${runclub.name}`}
    >
      <div class="wz-out-e" style={card.enter}>
        <div class="wz-out-f" style={card.rock}>
          <FeedCard {...runclub} />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style={poster.style}
      data-home="p-dutchgp"
      {...poster.data}
      role="img"
      aria-label={`Recommended event, ${dutchgp.name}`}
    >
      <div class="wz-out-e" style={poster.enter}>
        <div class="wz-out-f" style={poster.rock}>
          <Poster {...dutchgp} />
        </div>
      </div>
    </div>
  </Fragment>
</WuzyFrame>
