---
// Slide 02 — "Find Events, Communities & Join". The Discover screen.
//
// Composition: a large card leaning off the left edge with two small badges
// stacked down the right — deliberately asymmetric, where Feed is a pair.
import WuzyFrame from './WuzyFrame.astro';
import DiscoverScreen from './screens/DiscoverScreen.astro';
import HeroCard from './screens/HeroCard.astro';
import DateBadge from './screens/DateBadge.astro';
import NavBar from './screens/NavBar.astro';
import { upcoming, byName } from './screens/content';
import { float } from './screens/motion';

const lifted = ['d-hero', 'd-aug8', 'd-sep4'];

const hero = float({ x: 30, y: 48, parallax: -16, speed: 'heavy', tilt: 1.5 }, 0);
const first = float({ x: 100, y: 37, parallax: 20, speed: 'light', tilt: 2 }, 1);
const last = float({ x: 96, y: 72, parallax: 26, speed: 'light', tilt: 2 }, 2);

const aug8 = byName(upcoming, 'd-aug8');
const sep4 = byName(upcoming, 'd-sep4');
---

<WuzyFrame wellLabel="Discover screen, scrollable">
  <DiscoverScreen slot="screen" hollow={lifted} />

  <div slot="chrome" class="wz-pin wz-pin--bottom" aria-hidden="true">
    <NavBar />
  </div>

  <Fragment slot="outs">
    <div
      class="wz-out"
      style={hero.style}
      data-home="d-hero"
      {...hero.data}
      role="img"
      aria-label="Featured event, Neon Nights Festival"
    >
      <div class="wz-out-e" style={hero.enter}>
        <div class="wz-out-f" style={hero.rock}>
          <HeroCard />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style={first.style}
      data-home="d-aug8"
      {...first.data}
      role="img"
      aria-label={`Event date, ${aug8.day} ${aug8.month}`}
    >
      <div class="wz-out-e" style={first.enter}>
        <div class="wz-out-f" style={first.rock}>
          <DateBadge day={aug8.day} month={aug8.month} />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style={last.style}
      data-home="d-sep4"
      {...last.data}
      role="img"
      aria-label={`Event date, ${sep4.day} ${sep4.month}`}
    >
      <div class="wz-out-e" style={last.enter}>
        <div class="wz-out-f" style={last.rock}>
          <DateBadge day={sep4.day} month={sep4.month} />
        </div>
      </div>
    </div>
  </Fragment>
</WuzyFrame>
