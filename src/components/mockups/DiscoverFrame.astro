---
// Slide 02 — "Find Events, Communities & Join". The Discover screen.
//
// Floating: the Neon Nights card and two date badges. Each names the slot it
// came from and the frame measures it, so nothing here encodes a position
// inside the screen.
import WuzyFrame from './WuzyFrame.astro';
import DiscoverScreen from './screens/DiscoverScreen.astro';
import HeroCard from './screens/HeroCard.astro';
import DateBadge from './screens/DateBadge.astro';
import NavBar from './screens/NavBar.astro';

const lifted = ['d-hero', 'd-aug8', 'd-sep4'];
---

<WuzyFrame wellLabel="Discover screen, scrollable" screenW={402}>
  <DiscoverScreen slot="screen" hollow={lifted} />

  <div slot="chrome" class="wz-pin wz-pin--bottom" style="--pl:50%" aria-hidden="true">
    <NavBar />
  </div>

  <Fragment slot="outs">
    <div
      class="wz-out"
      style="--x:30%;--y:48%;--z:26px;"
      data-home="d-hero"
      data-x="30"
      data-y="48"
      data-parallax="-16"
      role="img"
      aria-label="Featured event, Neon Nights Festival"
    >
      <div class="wz-out-e" style="--in-delay:0ms">
        <div class="wz-out-f" style="--amp:12px;--dur:6.8s;--delay:0.2s;--tilt:1.4deg">
          <HeroCard />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style="--x:100%;--y:37%;--z:26px;"
      data-home="d-aug8"
      data-x="100"
      data-y="37"
      data-parallax="20"
      role="img"
      aria-label="Event date, 8 August"
    >
      <div class="wz-out-e" style="--in-delay:140ms">
        <div class="wz-out-f" style="--amp:10px;--dur:4.9s;--delay:0.8s;--tilt:2.4deg">
          <DateBadge day="8" month="AUG" />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style="--x:96%;--y:72%;--z:26px;"
      data-home="d-sep4"
      data-x="96"
      data-y="72"
      data-parallax="26"
      role="img"
      aria-label="Event date, 4 September"
    >
      <div class="wz-out-e" style="--in-delay:200ms">
        <div class="wz-out-f" style="--amp:11px;--dur:5.4s;--delay:0.1s;--tilt:2deg">
          <DateBadge day="4" month="SEP" />
        </div>
      </div>
    </div>
  </Fragment>
</WuzyFrame>
