---
// The date chip on an Up Coming row: a white card with the day over the month,
// the app's own ground on white, so it reads as a torn-off calendar page
// against whatever the event photo is doing behind it. The export used a navy
// that appeared nowhere else in the product.
interface Props {
  day: string;
  month: string;
  slotName?: string;
  hollow?: boolean;
}
const { day, month, slotName, hollow = false } = Astro.props;
---

<div
  class:list={[
    'grid h-84 w-72 shrink-0 place-items-center rounded-app-sm bg-white text-center',
    hollow && 'invisible',
  ]}
  data-slot={slotName}
>
  <div>
    <p class="text-app-numeric font-bold text-app-ground">{day}</p>
    <p class="text-app-meta font-semibold text-app-ground/70">{month}</p>
  </div>
</div>
