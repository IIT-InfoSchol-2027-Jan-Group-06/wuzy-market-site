---
// The Messages search field. Same box, same fill, same glyph and the same
// placeholder as Discover's — they are one component in the app, and used to
// differ on all four.
//
// The fill is the app's translucent-yellow surface: #FFE783 at 0.2 over the
// #000811 ground, which resolves to the #333428 the Discover search sampled at.
// Same material, written the way the export states it.
import Icon from './Icon.astro';

interface Props { slotName?: string; hollow?: boolean; floating?: boolean }
const { slotName, hollow = false, floating = false } = Astro.props;
---

<div
  class:list={[
    'flex h-48 w-326 items-center gap-12 rounded-app-md bg-ember/20 px-16',
    // Lifted, it floats over the marketing page — 20% alpha leaves the glyph
    // sitting on nothing, so it takes a slice of the app's ground with it.
    floating && 'wz-float',
    hollow && 'invisible',
  ]}
  data-slot={slotName}
>
  <Icon name="search" u={22} class="shrink-0 text-white/85" />
  <span class="text-app-body font-medium text-white/55">Search</span>
</div>
