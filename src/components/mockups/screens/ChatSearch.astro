---
// The Messages search field. Same box, same fill, same glyph and the same
// placeholder as Discover's — they are one component in the app, and used to
// differ on all four.
//
// The fill is bg-app-surface — the app's translucent-yellow resolved opaque —
// so the pill is the same colour floating over the marketing page as it is
// seated over the screen. It was wz-float's bare ground while lifted, which
// made the floating copy a near-invisible dark slab instead of the search bar
// the app actually shows.
import Icon from './Icon.astro';

interface Props { slotName?: string; hollow?: boolean; floating?: boolean }
const { slotName, hollow = false, floating = false } = Astro.props;
---

<div
  class:list={[
    'flex h-48 w-326 items-center gap-12 rounded-app-md bg-app-surface px-16',
    // Lifted, it gets the same hairline and elevation the floating rows carry.
    floating && 'wz-lifted',
    hollow && 'invisible',
  ]}
  data-slot={slotName}
>
  <Icon name="search" u={22} class="shrink-0 text-white/85" />
  <span class="text-app-body font-medium text-white/55">Search</span>
</div>
