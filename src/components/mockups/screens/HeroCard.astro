---
// The featured event. 326 x 438 design units — badge, heart, time, title,
// venue, price and the visit button, all one card, which is why it breaks out
// of the frame as a single piece.
//
// `peek` renders the copy-free version that sits half off the rail's edge, so
// the tile beside the real card is the same component rather than a hand-kept
// copy of its box.
import Icon from './Icon.astro';

interface Props {
  slotName?: string;
  hollow?: boolean;
  peek?: boolean;
}
const { slotName, hollow = false, peek = false } = Astro.props;
---

<div
  class:list={[
    'relative h-438 w-326 shrink-0 overflow-hidden rounded-app-lg',
    hollow && 'invisible',
  ]}
  data-slot={slotName}
>
  <img
    src={peek ? '/wuzy/img/discover/row-lasers.jpg' : '/wuzy/img/discover/hero.png'}
    alt=""
    draggable="false"
    class="size-full object-cover"
  />

  {!peek && (
    <>
      <!-- The copy block runs deep, so the ramp has to as well. -->
      <div class="absolute inset-x-0 bottom-0 h-280 bg-gradient-to-t from-black/90 via-black/55 to-transparent"></div>
      <!-- …and a short one at the top, because two chips sit up there and the
           artwork behind them is bright. Every other photo-with-content in the
           set scrims the corner its content lands in; this one did not. -->
      <div class="absolute inset-x-0 top-0 h-96 bg-gradient-to-b from-black/55 to-transparent"></div>

      <span
        class="absolute top-20 left-20 flex items-center gap-6 rounded-full bg-app-ground/85
               px-12 py-6 text-app-meta font-semibold text-ember ring-1 ring-ember/45 ring-inset"
      >
        <Icon name="heart" u={14} />
        Selling fast
      </span>

      <span class="wz-chrome absolute top-20 right-20 grid size-50 place-items-center rounded-full text-white">
        <Icon name="heart" u={24} />
      </span>

      <div class="absolute inset-x-0 bottom-0 px-20 pb-20">
        <p class="text-app-meta font-semibold text-ember">Tonight · 10PM</p>
        <h3 class="mt-4 text-app-hero font-bold text-white">Neon Nights<br />Festival</h3>

        <p class="mt-12 flex items-center gap-6 text-app-body font-medium text-white/90">
          <Icon name="pin" u={18} class="shrink-0" />
          Echo Warehouse, Brooklyn
        </p>

        <div class="mt-16 flex items-end justify-between">
          <div>
            <p class="text-app-meta font-medium text-white/80">Starting from</p>
            <p class="text-app-numeric font-bold text-ember">$45</p>
          </div>
          <span class="wz-accent grid h-44 place-items-center rounded-full px-24 text-app-title font-semibold">
            Visit
          </span>
        </div>
      </div>
    </>
  )}
</div>
