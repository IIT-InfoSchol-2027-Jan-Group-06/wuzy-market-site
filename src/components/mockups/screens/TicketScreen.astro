---
// The event detail screen, rebuilt as real DOM.
//
// Laid out on the shared 390 artboard: a 32 gutter and the common rhythm.
// Proportions come from event_info_black.svg, converted onto that ruler.
import Icon from './Icon.astro';
import EventTitle from './EventTitle.astro';
import EventWhen from './EventWhen.astro';
import MapCard from './MapCard.astro';

interface Props { hollow?: string[] }
const { hollow = [] } = Astro.props;
const out = (s: string) => hollow.includes(s);

const going = ['going-1.jpg', 'going-2.jpg', 'going-3.jpg'];
const img = (f: string) => `/wuzy/img/ticket/${f}`;
---

<div class="wz-screen font-app relative w-full bg-app-ground pb-180 text-white antialiased select-none">
  <!-- Hero. Wider than the screen by design — the export bleeds it 42 units
       past the right edge — and it ramps into the ground rather than ending. -->
  <img
    src={img('hero.jpg')}
    alt=""
    draggable="false"
    class="absolute top-0 left-0 h-575 w-436 object-cover object-top"
  />
  <!-- Matches the image it covers, not the screen: it was 42 units narrower
       than the photo, leaving the bleed unscrimmed. -->
  <div class="absolute top-0 left-0 h-575 w-436 bg-gradient-to-b from-transparent via-app-ground/45 to-app-ground"></div>

  <!-- Title sits over the faded tail of the hero, level with the heart -->
  <div class="relative flex items-start justify-between px-32 pt-418">
    <EventTitle slotName="t-title" hollow={out('t-title')} />
    <span class="wz-chrome mt-8 grid size-50 shrink-0 place-items-center rounded-full text-white">
      <Icon name="heart" u={24} />
    </span>
  </div>

  <p class="relative mt-20 px-32 text-app-body font-medium text-ember/85">
    Released on October 3, 2025 via Republic Records, Taylor Swift's twelfth
    album was crafted across three continents… <span class="font-semibold text-ember">Show more</span>
  </p>

  <!-- Who's going, and when -->
  <div class="relative mt-40 flex items-start justify-between px-32">
    <div>
      <div class="flex items-center gap-12">
        <div class="flex">
          {going.map((g, i) => (
            <img
              src={img(g)}
              alt=""
              draggable="false"
              class:list={[
                'size-34 rounded-full object-cover ring-1 ring-app-ground',
                i > 0 && '-ml-12',
              ]}
            />
          ))}
        </div>
        <span class="text-app-body font-semibold text-white">5+</span>
      </div>
      <p class="mt-16 text-app-body font-semibold text-ember">88 Palms</p>
      <p class="mt-4 text-app-meta font-medium text-ember/75">Lekki, Lagos</p>
    </div>

    <EventWhen slotName="t-when" hollow={out('t-when')} />
  </div>

  <!-- The map runs wider than the copy, half a gutter in on each side -->
  <div class="relative mt-40 px-16">
    <MapCard slotName="t-map" hollow={out('t-map')} />
  </div>
</div>
