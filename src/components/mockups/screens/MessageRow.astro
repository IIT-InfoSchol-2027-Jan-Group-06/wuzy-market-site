---
// One conversation. 48 tall, avatar 48 at x 35, copy from x 102, then the
// timestamp and the unread dot ranged right.
interface Props {
  name: string;
  preview: string;
  time: string;
  avatar: string;
  unread?: boolean;
  slotName?: string;
  hollow?: boolean;
}
const { name, preview, time, avatar, unread = true, slotName, hollow = false } = Astro.props;
---

<div
  class:list={['flex h-48 w-323 items-center gap-19', hollow && 'invisible']}
  data-slot={slotName}
>
  <img
    src={avatar}
    alt=""
    draggable="false"
    class="size-48 shrink-0 rounded-full object-cover ring-1 ring-ember/85"
  />

  <div class="min-w-0 flex-1">
    <p class="truncate text-u-16 font-semibold text-white">{name}</p>
    <p class="mt-3 truncate text-u-16 font-medium text-white/90">{preview}</p>
  </div>

  <!-- The timestamp rides low and the dot high, the way the export sets them -->
  <span class="mt-14 shrink-0 text-u-15 font-medium text-white/85">{time}</span>
  <span
    class:list={['mb-14 size-10 shrink-0 rounded-full', unread ? 'bg-ember' : 'bg-transparent']}
  ></span>
</div>
