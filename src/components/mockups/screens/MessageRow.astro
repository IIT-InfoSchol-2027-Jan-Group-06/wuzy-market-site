---
// One conversation. 56 tall, on the shared 32 gutter, with the timestamp and
// the unread dot ranged right.
interface Props {
  name: string;
  preview: string;
  time: string;
  avatar: string;
  unread?: boolean;
  slotName?: string;
  hollow?: boolean;
  /** Lifted out of the frame: takes a slice of the app's ground with it, or
   *  white-on-dark content has nothing to sit on over the site's own page.
   *  The box and radius are unchanged, so the piece lands exactly on its slot. */
  floating?: boolean;
}
const {
  name, preview, time, avatar,
  unread = true, slotName, hollow = false, floating = false,
} = Astro.props;
---

<div
  class:list={[
    'flex h-56 w-326 items-center gap-16 rounded-app-md',
    floating && 'wz-float',
    hollow && 'invisible',
  ]}
  data-slot={slotName}
>
  <img
    src={avatar}
    alt=""
    draggable="false"
    class="size-48 shrink-0 rounded-full object-cover ring-1 ring-ember/80"
  />

  <div class="min-w-0 flex-1">
    <p class="truncate text-app-title font-semibold text-white">{name}</p>
    <p class="truncate text-app-meta font-medium text-white/75">{preview}</p>
  </div>

  <!-- Both ranged on the row's centre line. They used to be nudged apart by
       hand-picked margins that only held at one row height. -->
  <span class="shrink-0 text-app-meta font-medium text-white/60">{time}</span>
  <span
    class:list={['size-10 shrink-0 rounded-full', unread ? 'bg-ember' : 'bg-transparent']}
  ></span>
</div>
