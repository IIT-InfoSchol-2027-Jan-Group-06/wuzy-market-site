---
// The Wuzy feed, rebuilt as real DOM.
//
// Laid out on the shared 390 artboard: a 32 gutter, a 326 content column, and
// the common rhythm — 40 between sections, 20 from a label to its content.
//
// `hollow` on a piece leaves its box in place but blanks it, which is how the
// breakouts get a gap to fly back into.
import FeedCard from './FeedCard.astro';
import Poster from './Poster.astro';
import Icon from './Icon.astro';
import { posts, posters } from './content';

interface Props { hollow?: string[] }
const { hollow = [] } = Astro.props;
const out = (slot: string) => hollow.includes(slot);
---

{/* pt-56 is the status-bar clearance, the same on all four screens */}
<div class="wz-screen font-app w-full bg-app-ground pt-56 pb-180 text-white antialiased select-none">
  <!-- Header. The action sits in the same 50 chrome pill the other screens use
       for theirs, so the corner reads the same wherever you land. -->
  <header class="flex items-center justify-between px-32">
    <h1 class="text-app-display font-bold tracking-[-0.02em] text-ember">WUZY</h1>
    <span class="wz-chrome grid size-50 place-items-center rounded-full text-white">
      <Icon name="bell" u={24} />
    </span>
  </header>

  <h2 class="mt-40 px-32 text-app-body font-semibold text-ember">Recent</h2>

  <div class="mt-20 px-32">
    <FeedCard {...posts[0]} hollow={out(posts[0].slotName)} />
  </div>

  <h2 class="mt-40 px-32 text-app-body font-semibold text-ember">Recommendations</h2>

  <!-- Rail. It leads at 8, not the page's 32, so it reads as running off the
       edge — and it scrolls, so the run-off is reachable rather than lost.
       Compose is chrome on this screen, pinned by the frame. -->
  <div class="wz-rail mt-20 flex gap-12 px-8">
    {posters.map((p) => (
      <Poster {...p} hollow={out(p.slotName)} />
    ))}
  </div>

  <div class="mt-40 flex flex-col gap-24 px-32">
    {posts.slice(1).map((p) => (
      <FeedCard {...p} hollow={out(p.slotName)} />
    ))}
  </div>

  <p class="mt-40 text-center text-app-meta font-semibold text-ember">Caught up with life</p>
</div>
