---
// An Upcoming row: 326 x 128 of photo with the event name and host over it,
// and the date badge on the right.
import DateBadge from './DateBadge.astro';

interface Props {
  name: string;
  host: string;
  avatar: string;
  photo: string;
  day: string;
  month: string;
  badgeSlot?: string;
  hollowBadge?: boolean;
}
const { name, host, avatar, photo, day, month, badgeSlot, hollowBadge = false } = Astro.props;
---

<div class="relative h-128 w-326 overflow-hidden rounded-app-md">
  <img src={photo} alt="" draggable="false" class="size-full object-cover" />
  <!-- Reads left-heavy, so the scrim is too. It ends at transparent like
       every other one: it used to hold a 10% floor across the whole photo,
       including the third where only the white badge sits. -->
  <div class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/35 to-transparent"></div>

  <!-- Copy and badge share one centred flex row rather than being absolutely
       placed and pulled back by a transform, so the badge is centred by the
       layout instead of by arithmetic that has to stay in sync with its height. -->
  <div class="absolute inset-0 flex items-center justify-between px-16">
    <div class="flex flex-col gap-8">
      <p class="text-app-title font-semibold text-white">{name}</p>
      <div class="flex items-center gap-8">
        <img
          src={avatar}
          alt=""
          draggable="false"
          class="size-24 rounded-full object-cover ring-1 ring-ember/80"
        />
        <span class="text-app-meta font-medium text-white/90">{host}</span>
      </div>
    </div>

    <DateBadge day={day} month={month} slotName={badgeSlot} hollow={hollowBadge} />
  </div>
</div>
