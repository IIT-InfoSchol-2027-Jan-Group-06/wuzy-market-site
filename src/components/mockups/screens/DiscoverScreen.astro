---
// Discover, rebuilt as real DOM.
//
// Laid out on the shared 390 artboard: a 32 gutter, a 326 content column, and
// the common rhythm — 40 between sections, 20 from a label to its content.
//
// That rhythm is what fixes this screen's worst spacing bug: "Up Coming" used
// to sit closer to the rail above it than to the rows it labels, so it read as
// belonging to the wrong section.
import HeroCard from './HeroCard.astro';
import EventRow from './EventRow.astro';
import Icon from './Icon.astro';
import { upcoming } from './content';

interface Props { hollow?: string[] }
const { hollow = [] } = Astro.props;
const out = (s: string) => hollow.includes(s);

// Four, not five. The reference runs a fifth off the right edge; at this size
// it just reads as a chip sliced in half, so the rail ends on the page margin.
const chips = ['All', 'Music', 'Reading', 'Movies'];
---

{/* pt-56 is the status-bar clearance, the same on all four screens */}
<div class="wz-screen font-app w-full bg-app-ground pt-56 pb-180 text-white antialiased select-none">
  <header class="flex items-center justify-between px-32">
    <h1 class="text-app-display font-bold text-ember">Explore</h1>
    <span class="wz-chrome grid size-50 place-items-center rounded-full text-white">
      <Icon name="ticket" u={24} />
    </span>
  </header>

  <div class="mt-24 px-32">
    <div class="flex h-48 items-center gap-12 rounded-app-md bg-ember/20 px-16">
      <Icon name="search" u={22} class="shrink-0 text-white/85" />
      <span class="text-app-body font-medium text-white/55">Search</span>
    </div>
  </div>

  <div class="mt-16 flex gap-8 overflow-hidden px-32">
    {chips.map((c, i) => (
      <span
        class:list={[
          'grid h-28 shrink-0 place-items-center rounded-full px-14 text-app-meta font-semibold',
          i === 0
            ? 'bg-ember text-app-ground'
            // Inset ring, not an outset one. An outset ring paints a second
            // rounded rect one pixel outside the chip's own, and at this size
            // the two radii disagree enough that the corners read as squared
            // off. The active chip looked right only because it has no ring.
            : 'bg-ember/25 text-ember ring-1 ring-ember/70 ring-inset',
        ]}
      >
        {c}
      </span>
    ))}
  </div>

  <h2 class="mt-40 px-32 text-app-body font-semibold text-ember">Today</h2>

  <!-- Featured rail — the next card peeks in at the edge, and the rail
       scrolls so it can be pulled fully into view. It renders a real HeroCard
       rather than a copy of its box, so the two cannot desync. -->
  <div class="wz-rail mt-20 flex gap-12 px-32">
    <HeroCard slotName="d-hero" hollow={out('d-hero')} />
    <HeroCard peek />
  </div>

  <h2 class="mt-40 px-32 text-app-body font-semibold text-ember">Upcoming</h2>

  <div class="mt-20 flex flex-col gap-16 px-32">
    {upcoming.map((r) => (
      <EventRow {...r} badgeSlot={r.slotName} hollowBadge={out(r.slotName)} />
    ))}
  </div>

  <p class="mt-40 text-center text-app-meta font-semibold text-ember">Caught up with life</p>
</div>
