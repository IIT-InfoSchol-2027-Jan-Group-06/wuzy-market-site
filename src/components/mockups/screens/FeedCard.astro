---
// One post in the feed: a photo with the poster's identity over its top-left
// corner. 326 x 320 design units.
//
// Rendered twice for the card that breaks out of the frame — once here inside
// the screen as an empty slot, once as the floating piece — so `hollow` blanks
// the contents while keeping the box, which is what leaves the gap the piece
// flies back into.
interface Props {
  name: string;
  place: string;
  avatar: string;
  photo: string;
  slotName?: string;
  hollow?: boolean;
}
const { name, place, avatar, photo, slotName, hollow = false } = Astro.props;
---

<div
  class:list={[
    'relative h-320 w-326 shrink-0 overflow-hidden rounded-app-lg',
    hollow && 'invisible',
  ]}
  data-slot={slotName}
>
  <img src={photo} alt="" draggable="false" class="size-full object-cover" />

  <!-- The export sets the name straight onto the photo, which holds over the
       dark frames and fails over a bright one. A scrim keeps the placement and
       makes it work on any image. Its depth is the identity block plus its
       inset, so the copy always sits in the strong end of the ramp. -->
  <div class="absolute inset-x-0 top-0 h-96 bg-gradient-to-b from-black/70 to-transparent"></div>

  <div class="absolute top-20 left-20 flex items-center gap-12">
    <img
      src={avatar}
      alt=""
      draggable="false"
      class="size-34 shrink-0 rounded-full object-cover ring-1 ring-ember/80"
    />
    <div>
      <p class="text-app-title font-semibold text-white">{name}</p>
      <p class="text-app-meta font-medium text-white/85">{place}</p>
    </div>
  </div>
</div>
