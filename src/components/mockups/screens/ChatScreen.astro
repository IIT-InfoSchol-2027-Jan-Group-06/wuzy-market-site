---
// Messages, rebuilt as real DOM.
//
// Boxes come from chat_feed.svg, converted onto the shared ruler.
// Laid out on the shared 390 artboard: a 32 gutter and the common rhythm.
//
// The chips state the app's surface plainly: the active one is solid ember,
// the rest are the same yellow at 0.25 behind an ember hairline — the same
// treatment Discover's use.
import ChatSearch from './ChatSearch.astro';
import MessageRow from './MessageRow.astro';
import { threads } from './content';

interface Props { hollow?: string[] }
const { hollow = [] } = Astro.props;
const out = (s: string) => hollow.includes(s);

const chips = ['All', 'Unread', 'Community', 'Groups'];


---

{/* pt-56 is the status-bar clearance, the same on all four screens */}
<div class="wz-screen font-app relative w-full bg-app-ground pt-56 pb-180 text-white antialiased select-none">
  <h1 class="px-32 text-app-display font-bold text-ember">Messages</h1>

  <div class="mt-24 px-32">
    <ChatSearch slotName="c-search" hollow={out('c-search')} />
  </div>

  <div class="mt-16 flex gap-8 overflow-hidden px-32">
    {chips.map((c, i) => (
      <span
        class:list={[
          'grid h-28 shrink-0 place-items-center rounded-full px-14 text-app-meta font-semibold',
          i === 0
            ? 'bg-ember text-app-ground'
            : 'bg-ember/25 text-ember ring-1 ring-ember/70 ring-inset',
        ]}
      >
        {c}
      </span>
    ))}
  </div>

  <div class="mt-40 flex flex-col gap-12 px-32">
    {threads.map((t) => (
      <MessageRow
        name={t.name}
        preview={t.preview}
        time={t.time}
        avatar={t.avatar}
        slotName={t.slotName}
        hollow={out(t.slotName)}
      />
    ))}
  </div>

  <!-- Compose is not part of this scrolling screen: it is chrome, and its
       hollow landing slot lives in ChatFrame's .wz-pin--compose — so once the
       floating button seats, it is pinned to the frame and never moves. -->
</div>
