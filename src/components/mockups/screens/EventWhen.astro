---
// Date over time, set as large as the title and ranged right against the
// screen edge. Lifts out of the frame, so it is its own component.
interface Props { slotName?: string; hollow?: boolean }
const { slotName, hollow = false } = Astro.props;
---

<p
  class:list={['text-app-hero text-right font-bold text-ember', hollow && 'invisible']}
  data-slot={slotName}
>
  9 Aug<br />6PM
</p>
