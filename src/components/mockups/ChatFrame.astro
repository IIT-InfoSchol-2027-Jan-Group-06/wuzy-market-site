const pins = [
  {
    style: '--pl:50.000%;--pt:92.454%;--w:calc(var(--fw) * 0.703674)',
    glass: 'wz-glass--pill',
    glassStyle: '--pw:290;--ph:50',
    src: '/wuzy/chat_feed__nav.svg',
    imgStyle: '--l:-2.069%;--t:-12.000%;--ww:104.138%',
  },
];

const outs = [
  {
    style: '--x:17%;--y:15.5%;--z:130px;--w:calc(var(--fw) * 0.812865);--hs:1.00000;',
    data: { 'data-parallax': '-20', 'data-x': '17', 'data-y': '15.5', 'data-hx': '201.50', 'data-hy': '139.50', 'data-hh': '41.00' },
    label: 'Search',
    e: '--in-delay:0ms',
    f: '--amp:8px;--dur:5.8s;--delay:0.0s',
    wrap: 'wz-glass wz-glass--pill',
    wrapStyle: '--pw:335;--ph:41',
    src: '/wuzy/chat_feed__search.svg',
    imgStyle: '--l:-1.791%;--t:-14.634%;--ww:103.582%',
  },
  {
    style: '--x:99%;--y:36%;--z:120px;--w:calc(var(--fw) * 0.749485);--hs:1.26263;',
    data: { 'data-parallax': '24', 'data-x': '99', 'data-y': '36', 'data-hx': '197.50', 'data-hy': '440.00', 'data-hh': '76.00' },
