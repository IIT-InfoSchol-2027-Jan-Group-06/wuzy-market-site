---
// Slide 04 — "Conversations under one roof". The Messages screen.
//
// Floating: the search field and two of the message rows. The compose button
// is chrome rather than a breakout, like every other button across the four
// screens — static, always on top.
//
// This screen has the least scroll runway of the four: 852 units of content
// against roughly 801 visible. Homing still fires, there is just little travel.
// That is the export, not a porting bug.
import WuzyFrame from './WuzyFrame.astro';
import ChatScreen from './screens/ChatScreen.astro';
import ChatSearch from './screens/ChatSearch.astro';
import MessageRow from './screens/MessageRow.astro';
import NavBar from './screens/NavBar.astro';
import PlusButton from './screens/PlusButton.astro';

const img = (f: string) => `/wuzy/img/chat/${f}`;

const lifted = ['c-search', 'c-alex', 'c-dean', 'c-plus'];
---

<WuzyFrame wellLabel="Messages screen, scrollable" screenW={393}>
  <ChatScreen slot="screen" hollow={lifted} />

  <div slot="chrome" class="wz-pin wz-pin--bottom" style="--pl:50%" aria-hidden="true">
    <NavBar />
  </div>

  <Fragment slot="outs">
    <div
      class="wz-out"
      style="--x:17%;--y:15.5%;--z:26px;"
      data-home="c-search"
      data-x="17"
      data-y="15.5"
      data-parallax="-20"
      role="img"
      aria-label="Search conversations"
    >
      <div class="wz-out-e" style="--in-delay:0ms">
        <div class="wz-out-f" style="--amp:8px;--dur:5.8s;--delay:0s">
          <ChatSearch />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style="--x:99%;--y:36%;--z:26px;"
      data-home="c-dean"
      data-x="99"
      data-y="36"
      data-parallax="24"
      role="img"
      aria-label="Message from dean di laurentis"
    >
      <div class="wz-out-e" style="--in-delay:90ms">
        <div class="wz-out-f" style="--amp:12px;--dur:5.6s;--delay:0.7s;--tilt:1.5deg">
          <MessageRow
            name="dean di laurentis"
            preview="Be a fun teammate!"
            time=".2d"
            avatar={img('lily.jpg')}
            floating
          />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style="--x:-1%;--y:68%;--z:26px;"
      data-home="c-alex"
      data-x="-1"
      data-y="68"
      data-parallax="-24"
      role="img"
      aria-label="Message from alex wanner"
    >
      <div class="wz-out-e" style="--in-delay:170ms">
        <div class="wz-out-f" style="--amp:11px;--dur:6.1s;--delay:0.3s;--tilt:1.5deg">
          <MessageRow
            name="alex wanner"
            preview="Just do it bro,"
            time=".1d"
            avatar={img('alex.jpg')}
            floating
          />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style="--x:101%;--y:84%;--z:26px;"
      data-home="c-plus"
      data-x="101"
      data-y="84"
      data-parallax="16"
      role="img"
      aria-label="New message"
    >
      <div class="wz-out-e" style="--in-delay:240ms">
        <div class="wz-out-f" style="--amp:9px;--dur:5s;--delay:0.4s">
          <PlusButton />
        </div>
      </div>
    </div>
  </Fragment>
</WuzyFrame>
