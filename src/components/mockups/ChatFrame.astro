---
// Slide 04 — "Conversations under one roof". The Messages screen.
//
// Composition: a full-height ladder — search up near the top, two rows
// alternating across the middle, compose low on the right. The tallest spread
// of the four, because a message list is the most vertical screen.
//
// It also has the least scroll runway, so the pieces have little travel to
// home across. That is the export's own proportions, not a porting bug.
import WuzyFrame from './WuzyFrame.astro';
import ChatScreen from './screens/ChatScreen.astro';
import ChatSearch from './screens/ChatSearch.astro';
import MessageRow from './screens/MessageRow.astro';
import NavBar from './screens/NavBar.astro';
import PlusButton from './screens/PlusButton.astro';
import { threads, byName } from './screens/content';
import { float } from './screens/motion';

const lifted = ['c-search', 'c-alex', 'c-dean', 'c-plus'];

const search = float({ x: 17, y: 15.5, parallax: -20, speed: 'light' }, 0);
const dean = float({ x: 99, y: 36, parallax: 24, speed: 'heavy', tilt: 1.5 }, 1);
const alex = float({ x: -1, y: 68, parallax: -24, speed: 'mid', tilt: 1.5 }, 2);
const compose = float({ x: 101, y: 84, parallax: 16, speed: 'light' }, 3);

const deanRow = byName(threads, 'c-dean');
const alexRow = byName(threads, 'c-alex');
---

<WuzyFrame wellLabel="Messages screen, scrollable">
  <ChatScreen slot="screen" hollow={lifted} />

  <div slot="chrome" class="wz-pin wz-pin--bottom" aria-hidden="true">
    <NavBar />
  </div>

  <Fragment slot="outs">
    <div
      class="wz-out"
      style={search.style}
      data-home="c-search"
      {...search.data}
      role="img"
      aria-label="Search conversations"
    >
      <div class="wz-out-e" style={search.enter}>
        <div class="wz-out-f" style={search.rock}>
          <ChatSearch floating />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style={dean.style}
      data-home="c-dean"
      {...dean.data}
      role="img"
      aria-label={`Message from ${deanRow.name}`}
    >
      <div class="wz-out-e" style={dean.enter}>
        <div class="wz-out-f" style={dean.rock}>
          <MessageRow {...deanRow} floating />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style={alex.style}
      data-home="c-alex"
      {...alex.data}
      role="img"
      aria-label={`Message from ${alexRow.name}`}
    >
      <div class="wz-out-e" style={alex.enter}>
        <div class="wz-out-f" style={alex.rock}>
          <MessageRow {...alexRow} floating />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style={compose.style}
      data-home="c-plus"
      {...compose.data}
      role="img"
      aria-label="New message"
    >
      <div class="wz-out-e" style={compose.enter}>
        <div class="wz-out-f" style={compose.rock}>
          <PlusButton />
        </div>
      </div>
    </div>
  </Fragment>
</WuzyFrame>
