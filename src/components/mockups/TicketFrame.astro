---
// Slide 03 — "Direct in-app Ticketing". The event detail screen.
//
// Floating: the title, the date/time and the map card. Pinned: back, and
// share + more. Those two are top-anchored chrome — they sit at the same
// coordinate as the screen does at rest, so they take their position straight
// from the export rather than from the well's lower edge like a nav bar.
import WuzyFrame from './WuzyFrame.astro';
import TicketScreen from './screens/TicketScreen.astro';
import EventTitle from './screens/EventTitle.astro';
import EventWhen from './screens/EventWhen.astro';
import MapCard from './screens/MapCard.astro';
import Icon from './screens/Icon.astro';
import { float } from './screens/motion';

const title = float({ x: -9, y: 45, parallax: -20, speed: 'mid', tilt: 1.5 }, 0);
const when = float({ x: 103, y: 50, parallax: 16, speed: 'mid', tilt: 2 }, 1);
const map = float({ x: 58, y: 96, parallax: 22, speed: 'heavy' }, 2);

const lifted = ['t-title', 't-when', 't-map'];
---

<WuzyFrame wellLabel="Event screen, scrollable">
  <TicketScreen slot="screen" hollow={lifted} />

  <!-- Top chrome, on the page gutter so it lines up with the copy below, and
       at the same 56 inset the other three screens give their headers — this
       screen's hero bleeds to the very top, so its chrome is the only thing
       holding the status-bar clearance. -->
  <div slot="chrome" class="wz-pin wz-pin--at" style="--sx:32;--sy:56" aria-hidden="true">
    <span class="wz-chrome grid size-50 place-items-center rounded-full text-white">
      <Icon name="back" u={24} />
    </span>
  </div>

  <div slot="chrome" class="wz-pin wz-pin--at" style="--sx:208;--sy:56" aria-hidden="true">
    <span class="wz-chrome flex h-50 w-150 items-center justify-around rounded-full text-white">
      <Icon name="share" u={24} />
      <Icon name="more" u={24} />
    </span>
  </div>

  <!-- The buy bar. Static chrome: the map slides up behind it as the screen
       scrolls, and it never moves. Gift and ticket together span the content
       column exactly, gutter to gutter. -->
  <div slot="chrome" class="wz-pin wz-pin--foot" style="--sx:32;--sb:36" aria-hidden="true">
    <span class="wz-chrome grid h-50 w-60 place-items-center rounded-full text-white">
      <Icon name="gift" u={24} />
    </span>
  </div>

  <div slot="chrome" class="wz-pin wz-pin--foot" style="--sx:104;--sb:36" aria-hidden="true">
    <span class="wz-accent grid h-50 w-254 place-items-center rounded-full text-app-title font-semibold">
      Buy ticket
    </span>
  </div>

  <Fragment slot="outs">
    <div
      class="wz-out"
      style={title.style}
      data-home="t-title"
      {...title.data}
      role="img"
      aria-label="Event title, The Life of a Showgirl"
    >
      <div class="wz-out-e" style={title.enter}>
        <div class="wz-out-f" style={title.rock}>
          <EventTitle />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style={when.style}
      data-home="t-when"
      {...when.data}
      role="img"
      aria-label="Event date and time, 9 August, 6PM"
    >
      <div class="wz-out-e" style={when.enter}>
        <div class="wz-out-f" style={when.rock}>
          <EventWhen />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style={map.style}
      data-home="t-map"
      {...map.data}
      role="img"
      aria-label="Venue map"
    >
      <div class="wz-out-e" style={map.enter}>
        <div class="wz-out-f" style={map.rock}>
          <MapCard />
        </div>
      </div>
    </div>
  </Fragment>
</WuzyFrame>
