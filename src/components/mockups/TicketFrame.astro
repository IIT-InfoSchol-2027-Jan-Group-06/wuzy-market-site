---
// Slide 03 — "Direct in-app Ticketing". The event detail screen.
//
// Floating: the title, the date/time and the map card. Pinned: back, and
// share + more. Those two are top-anchored chrome — they sit at the same
// coordinate as the screen does at rest, so they take their position straight
// from the export rather than from the well's lower edge like a nav bar.
import WuzyFrame from './WuzyFrame.astro';
import TicketScreen from './screens/TicketScreen.astro';
import EventTitle from './screens/EventTitle.astro';
import EventWhen from './screens/EventWhen.astro';
import MapCard from './screens/MapCard.astro';
import Icon from './screens/Icon.astro';

// Chrome placement in design units, straight from the SVG's own boxes.
const at = (x: number, y: number) =>
  `left:calc(${x} * var(--spacing));top:calc(${y} * var(--spacing));transform:none;width:auto`;

// Bottom-anchored chrome. The export puts these two on the map at y 697, but a
// fixed control cannot take a y from a screen that scrolls — same reason the
// nav bar is placed against the well's lower edge rather than at its exported
// coordinate. Horizontal positions are still the export's: 39 and 108.
const atFoot = (x: number, b: number) =>
  `left:calc(${x} * var(--spacing));top:auto;bottom:calc(${b} * var(--spacing));transform:none;width:auto`;

const lifted = ['t-title', 't-when', 't-map'];
---

<WuzyFrame wellLabel="Event screen, scrollable" screenW={360}>
  <TicketScreen slot="screen" hollow={lifted} />

  <div slot="chrome" class="wz-pin" style={at(25, 40)} aria-hidden="true">
    <span class="wz-chrome grid size-50 place-items-center rounded-full text-white">
      <Icon name="back" class="size-24" />
    </span>
  </div>

  <div slot="chrome" class="wz-pin" style={at(195, 40)} aria-hidden="true">
    <span class="wz-chrome flex h-50 w-150 items-center justify-around rounded-full text-white">
      <Icon name="share" class="size-23" />
      <Icon name="more" class="size-23" />
    </span>
  </div>

  <!-- The two actions. Static chrome: the map slides up behind them as the
       screen scrolls, and they never move — a persistent buy bar. -->
  <div slot="chrome" class="wz-pin" style={atFoot(39, 34)} aria-hidden="true">
    <span class="wz-chrome grid h-50 w-60 place-items-center rounded-full text-white">
      <Icon name="gift" class="size-26" />
    </span>
  </div>

  <div slot="chrome" class="wz-pin" style={atFoot(108, 34)} aria-hidden="true">
    <span
      class="wz-chrome grid h-50 w-208 place-items-center rounded-full
             text-u-22 font-semibold tracking-[0.02em] text-white"
    >
      BUY TICKET
    </span>
  </div>

  <Fragment slot="outs">
    <div
      class="wz-out"
      style="--x:-9%;--y:45%;--z:26px;"
      data-home="t-title"
      data-x="-9"
      data-y="45"
      data-parallax="-20"
      role="img"
      aria-label="Event title, The Life of a Showgirl"
    >
      <div class="wz-out-e" style="--in-delay:0ms">
        <div class="wz-out-f" style="--amp:10px;--dur:5.7s;--delay:0s;--tilt:1.6deg">
          <EventTitle />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style="--x:103%;--y:50%;--z:26px;"
      data-home="t-when"
      data-x="103"
      data-y="50"
      data-parallax="16"
      role="img"
      aria-label="Event date and time, 9 August 6PM"
    >
      <div class="wz-out-e" style="--in-delay:120ms">
        <div class="wz-out-f" style="--amp:10px;--dur:5s;--delay:0.8s;--tilt:2deg">
          <EventWhen />
        </div>
      </div>
    </div>

    <div
      class="wz-out"
      style="--x:58%;--y:96%;--z:26px;"
      data-home="t-map"
      data-x="58"
      data-y="96"
      data-parallax="22"
      role="img"
      aria-label="Venue map, with gift and buy ticket"
    >
      <div class="wz-out-e" style="--in-delay:200ms">
        <div class="wz-out-f" style="--amp:8px;--dur:6.9s;--delay:0.2s">
          <MapCard />
        </div>
      </div>
    </div>
  </Fragment>
</WuzyFrame>
