---
import { bubbles, stats } from '../data/site';
import Stat from './Stat.astro';
const loop = [...bubbles, ...bubbles];
---
<section class="py-24">
  <div class="overflow-hidden py-6" aria-hidden="true">
    <div class="flex w-max animate-marquee gap-3">
      {loop.map(b => (
        <span class="flex items-center gap-2 whitespace-nowrap rounded-2xl bg-void-2 px-4 py-3 text-sm text-ink/80">
          <span class="h-6 w-6 shrink-0 rounded-full bg-void-3 ring-1 ring-olive-edge"></span>{b}
          <span class="h-1.5 w-1.5 rounded-full bg-butter"></span>
        </span>
      ))}
    </div>
  </div>

  <div class="mx-auto mt-16 max-w-5xl space-y-24 px-5">
    {stats.map((s, i) => <Stat n={s.n} t={s.t} wide={i === 1} />)}
  </div>
</section>
