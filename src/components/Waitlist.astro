---
import { formEndpoint } from '../data/site';
---

<section id="waitlist" class="relative px-5 py-28">
  <div class="mx-auto w-full max-w-[760px] text-center">
    <!-- Label -->
    <p class="waitlist-label text-sm font-medium uppercase tracking-[0.12em] text-whiteout/50">
      get early access
    </p>

    <!-- Headline (words reveal one-by-one) -->
    <h2 class="mt-4 font-control-compressed uppercase leading-[0.9] text-whiteout">
      <span class="block text-[clamp(48px,8vw,90px)]">
        {'save your'.split(' ').map((w) => (
          <span class="inline-block overflow-hidden align-top">
            <span class="waitlist-word inline-block will-change-transform">{w}&nbsp;</span>
          </span>
        ))}
      </span>
      <span class="block text-[clamp(48px,8vw,90px)]">
        <span class="waitlist-word inline-block will-change-transform">
          <span class="font-control-cursive font-normal lowercase text-twilight-blue">seat.</span>
        </span>
      </span>
    </h2>

    <!-- Sub copy -->
    <p class="waitlist-desc mx-auto mt-5 max-w-md text-base font-medium leading-relaxed text-whiteout/60">
      Be first in when Wuzy launches near you. Drop your email and we'll text you the second it's live.
    </p>

    <!-- Form -->
    <form
      id="waitlist-form"
      class="waitlist-form mx-auto mt-10 flex max-w-xl flex-col items-stretch gap-3 sm:flex-row"
      action={formEndpoint}
      method="POST"
    >
      <input
        id="waitlist-email"
        type="email"
        name="email"
        required
        placeholder="your@email.com"
        class="w-full flex-1 !rounded-full border border-whiteout/15 bg-whiteout/10 px-5 py-3 text-base font-medium text-whiteout placeholder:text-whiteout/40 backdrop-blur-xl outline-none transition-colors focus:border-whiteout/40"
      />
      <button
        type="submit"
        class="btn-glass-yellow !rounded-full px-6"
      >
        join waitlist
      </button>
    </form>

    <!-- Success state (shown via JS after submit) -->
    <div id="waitlist-success" class="mx-auto mt-10 hidden max-w-xl rounded-xl border border-whiteout/10 bg-whiteout/5 p-6 backdrop-blur-xl">
      <p class="font-control text-lg font-medium text-whiteout">you're in ✓</p>
      <p class="mt-2 text-sm font-normal text-whiteout/60">
        we'll text the moment Wuzy goes live near you. keep your phone close.
      </p>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Label fades in.
  gsap.from('.waitlist-label', {
    y: 24,
    autoAlpha: 0,
    duration: 0.7,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.waitlist-label', start: 'top 85%', once: true },
  });

  // Headline words rise up out of their overflow-hidden containers.
  const words = gsap.utils.toArray<HTMLElement>('.waitlist-word');
  if (words.length) {
    gsap.from(words, {
      yPercent: 110,
      autoAlpha: 0,
      rotate: 4,
      duration: 0.9,
      stagger: 0.09,
      ease: 'power4.out',
      scrollTrigger: {
        trigger: '.waitlist-label',
        start: 'top 80%',
        once: true,
      },
    });
  }

  // Everything below the headline staggers up.
  gsap.from('.waitlist-desc, .waitlist-form, .waitlist-success', {
    y: 30,
    autoAlpha: 0,
    duration: 0.8,
    stagger: 0.12,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.waitlist-desc', start: 'top 88%', once: true },
  });

  // Client-side success message (no page reload required).
  const form = document.getElementById('waitlist-form') as HTMLFormElement;
  const success = document.getElementById('waitlist-success');
  if (form && success) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      gsap.to(form, { autoAlpha: 0, y: -16, duration: 0.3, ease: 'power2.in', onComplete: () => {
        form.classList.add('hidden');
        success.classList.remove('hidden');
        gsap.from(success, { autoAlpha: 0, y: 16, duration: 0.4, ease: 'power3.out' });
      }});
    });
  }
</script>
