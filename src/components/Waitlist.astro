---
import { formEndpoint } from '../data/site';
---

<section id="waitlist" class="relative px-5 py-28">
  <div class="mx-auto w-full max-w-[760px] text-center">
    <!-- Label -->
    <p class="waitlist-label text-sm font-medium uppercase tracking-[0.08em] text-ember">
      get early access to
    </p>

    <!-- Headline (words reveal one-by-one) -->
    <h2 class="mt-4 font-display font-normal leading-[1.2] tracking-[0.02em] text-charcoal">
      <span class="block overflow-hidden text-[clamp(48px,7.5vw,84px)]">
        {'CONNECT AND'.split(' ').map((w) => (
          <span class="inline-block align-top">
            <span class="waitlist-word inline-block will-change-transform">{w}&nbsp;</span>
          </span>
        ))}
      </span>
      <span class="block overflow-hidden text-[clamp(48px,7.5vw,84px)]">
        <span class="waitlist-word inline-block will-change-transform">
          <span class="font-control-cursive lowercase text-ember">create stories</span>
        </span>
      </span>
    </h2>

    <!-- Sub copy -->
    <p class="waitlist-desc mx-auto mt-5 max-w-md text-base font-normal leading-relaxed tracking-normal text-charcoal/70">
      Be first to try Wuzy. we'll notify you the second it's live..
    </p>

    <!-- Form -->
    <form
      id="waitlist-form"
      class="waitlist-form mx-auto mt-10 flex max-w-xl flex-col items-stretch gap-3 sm:flex-row"
      action={formEndpoint}
      method="POST"
    >
      <input
        id="waitlist-email"
        type="email"
        name="email"
        required
        placeholder="your@email.com"
        class="w-full flex-1 !rounded-full border border-white/15 bg-white/[0.06] px-5 py-3 text-base font-medium text-charcoal placeholder:text-charcoal/40 outline-none backdrop-blur-xl transition-colors focus:border-ember/60 focus:bg-white/[0.1]"
      />
      <button
        type="submit"
        class="btn-glass-yellow !rounded-full px-6"
      >
        join waitlist
      </button>
    </form>

    <!-- Success state (shown via JS after submit) -->
    <div id="waitlist-success" class="mx-auto mt-10 hidden max-w-xl rounded-[32px] border border-white/15 bg-white/[0.06] p-6 shadow-card backdrop-blur-xl">
      <p class="font-control text-lg font-medium text-charcoal">you're in ✓</p>
      <p class="mt-2 text-sm font-normal text-charcoal/70">
        we'll text the moment Wuzy goes live near you. keep your phone close.
      </p>
    </div>

    <!-- Error state (shown via JS if the POST fails) -->
    <p id="waitlist-error" class="mt-4 hidden text-sm font-medium text-ember" role="alert">
      that didn't go through. give it another go in a moment.
    </p>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Label fades in.
  gsap.from('.waitlist-label', {
    y: 24,
    autoAlpha: 0,
    duration: 0.7,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.waitlist-label', start: 'top 85%', once: true },
  });

  // Headline words rise up out of their overflow-hidden containers.
  const words = gsap.utils.toArray<HTMLElement>('.waitlist-word');
  if (words.length) {
    gsap.from(words, {
      yPercent: 110,
      autoAlpha: 0,
      rotate: 4,
      duration: 0.9,
      stagger: 0.09,
      ease: 'power4.out',
      scrollTrigger: {
        trigger: '.waitlist-label',
        start: 'top 80%',
        once: true,
      },
    });
  }

  // Everything below the headline staggers up.
  gsap.from('.waitlist-desc, .waitlist-form', {
    y: 30,
    autoAlpha: 0,
    duration: 0.8,
    stagger: 0.12,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.waitlist-desc', start: 'top 88%', once: true },
  });

  // Submit in the background so we keep the inline success panel instead of
  // bouncing to the provider's thank-you page.
  //
  // This used to call preventDefault() and go straight to "you're in ✓"
  // without sending anything, so every signup was silently discarded. The
  // panel now shows only on a 2xx, and a failure says so and gives the form
  // back rather than pretending it worked.
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const success = document.getElementById('waitlist-success');
  const error = document.getElementById('waitlist-error');
  const submit = form?.querySelector('button[type="submit"]');

  if (form && success && error) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.classList.add('hidden');
      submit?.setAttribute('disabled', '');

      let ok = false;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        ok = res.ok;
      } catch {
        ok = false;
      }

      submit?.removeAttribute('disabled');

      if (!ok) {
        error.classList.remove('hidden');
        gsap.from(error, { autoAlpha: 0, y: 8, duration: 0.3, ease: 'power2.out' });
        return;
      }

      gsap.to(form, { autoAlpha: 0, y: -16, duration: 0.3, ease: 'power2.in', overwrite: 'auto', onComplete: () => {
        form.classList.add('hidden');
        success.classList.remove('hidden');
        gsap.from(success, { autoAlpha: 0, y: 16, duration: 0.4, ease: 'power3.out' });
      }});
    });
  }
</script>
