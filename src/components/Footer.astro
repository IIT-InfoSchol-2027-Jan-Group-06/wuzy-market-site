---
const socials = [
  { label: 'instagram', href: 'https://instagram.com' },
  { label: 'twitter / x', href: 'https://twitter.com' },
  { label: 'tiktok', href: 'https://tiktok.com' },
  { label: 'discord', href: 'https://discord.com' },
];

const legal = [
  { label: 'privacy', href: '#' },
  { label: 'terms', href: '#' },
  { label: 'contact', href: '#' },
];
---

<footer class="px-5 pt-16 pb-8">
  <div class="mx-auto w-full max-w-[1150px]">
    <!-- Simple brand row -->
    <div class="flex flex-col items-center justify-between gap-6 sm:flex-row">
      <a href="/" class="font-control text-lg font-bold tracking-[0.08em] text-charcoal">
        WUZY
      </a>

      <!-- Social links -->
      <div class="flex items-center gap-5 text-sm font-medium text-steel">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-ember">
            {s.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Legal row -->
    <div class="mt-8 flex flex-col items-center justify-between gap-4 border-t border-charcoal/10 pt-5 sm:flex-row">
      <p class="text-xs font-normal text-steel">
        © {new Date().getFullYear()} Wuzy. all rights reserved.
      </p>
      <div class="flex items-center gap-5 text-xs font-medium text-steel">
        {legal.map((l) => (
          <a href={l.href} class="transition-colors hover:text-charcoal">
            {l.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
