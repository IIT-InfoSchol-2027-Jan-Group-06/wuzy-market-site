<section id="hero" class="relative flex min-h-screen items-center justify-center overflow-hidden px-5 pt-24 pb-20">
  <div class="w-full max-w-[1150px] text-center">
  
    <h1 class="hero-title mt-2 font-display text-[clamp(48px,7.5vw,96px)] leading-[1.13] tracking-[0.01em] font-normal text-charcoal">
      <span class="block uppercase">every connection</span>
      <span class="block uppercase">
        has a <span class="font-control-cursive lowercase text-ember [font-size:1.15em]">
          <span id="cycle-word" class="font-control-cursive">story.</span>
        </span>
      </span>
    </h1>

    <p class="hero-copy mx-auto mt-6 max-w-xl text-base font-normal leading-relaxed tracking-[-0.01em] text-charcoal/70">
      Wuzy matches you with like-minded people, communities, 
      and verified events, so you always show up with your crowd.
    </p>

    <div class="hero-cta mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#waitlist"
        class="btn-glass-yellow !rounded-full px-7"
      >
        Join the waitlist
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Direct children only. As a descendant selector this also matched the two
  // spans nested inside the second line, so "story." got y:60 compounded three
  // times (180px) with opacity multiplied out, and started a stagger step late.
  gsap.from('.hero-title > span', {
    y: 60, opacity: 0, duration: 1, stagger: 0.12, ease: 'power4.out',
  });
  gsap.from('.hero-copy', { y: 24, opacity: 0, duration: 0.8, delay: 0.4, ease: 'power3.out' });
  gsap.from('.hero-cta a', { y: 16, opacity: 0, duration: 0.7, stagger: 0.12, delay: 0.55, ease: 'power3.out' });
//words list for the hero
  const words = ['story.', 'vibe.', 'scene.', 'match.'];
  let index = 0;
  const cycleWord = document.getElementById('cycle-word');

  if (cycleWord) {
  const swap = () => {
    index = (index + 1) % words.length;
    gsap.to(cycleWord, {
      y: -30,
      opacity: 0,
      duration: 0.3,
      ease: 'power2.in',
      onComplete: () => {
        cycleWord.textContent = words[index];
        gsap.fromTo(
          cycleWord,
          { y: 30, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.4, ease: 'power2.out' }
        );
      },
    });
  };

  // Gate the loop on the hero actually being on screen. Ungated it kept
  // swapping — and kept GSAP's ticker alive — while the reader was twenty
  // viewports down, and the word had silently moved on by the time they
  // scrolled back up.
  let cycleCall: ReturnType<typeof gsap.delayedCall> | null = null;

  const startCycle = (delay: number) => {
    cycleCall = gsap.delayedCall(delay, function repeat() {
      swap();
      cycleCall = gsap.delayedCall(2.6, repeat);
    });
  };

  ScrollTrigger.create({
    trigger: '#hero',
    start: 'top bottom',
    end: 'bottom top',
    onToggle: (self) => {
      if (self.isActive) {
        if (!cycleCall) startCycle(2.6);
      } else {
        cycleCall?.kill();
        cycleCall = null;
      }
    },
  });

  startCycle(4);
  }
</script>