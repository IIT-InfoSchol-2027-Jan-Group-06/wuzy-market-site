---
import { Image } from 'astro:assets';
import heroBg from '../assets/bg-hero.jpg'; 
import noise from '../assets/nnnoise.svg';

---



<section id="Hero" class="min-h-screen flex justify-center">
    <!-- Background Image -->
    <Image 
        src={heroBg} 
        alt="Hero Background" 
        class="absolute inset-0 w-full h-full  blur-xs object-cover object-center -z-20"
    />
    <Image 
        src={noise}
        alt="noise"

        class="absolute inset-0 w-full h-full  blur-xs object-cover object-center -z-19"
    />


    <!--Hero Texts -->
    <div class="text-center content-center">
        <h1 class="hero-title text-white mix-blend-difference text-8xl/30 tracking-tight text-balance ">
            <span class="font-Playfair italic font-semibold">Every Connection</span><br>
            <span class="font-sans font-bold">Has a Story</span>
        </h1>
    </div>

</section>


<script>
    import {gsap} from "gsap"
    const herpSplit = 
    gsap.from(".hero-title", {
    y: 50,
    opacity: 0,
    duration: 1,
    ease: "power3.out"
  });

</script>