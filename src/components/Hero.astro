---
import { Image } from 'astro:assets';
import heroBg from '../assets/bg-hero.jpg'; 
---



<section id="Hero" class="min-h-screen flex justify-center">
    <!-- Background Image -->
    <Image 
        src={heroBg} 
        alt="Hero Background" 
        class="absolute inset-0 w-full h-full object-cover object-center -z-20"
    />

    <!--Hero Texts -->
    <div class="text-center content-center">
        <h1 class="hero-title text-amber-50 font-sans font-bold text-8xl/30 tracking-tight text-balance ">EVERY CONNECTION<br> HAS STORY</h1>
    </div>

</section>


<script>
    import {gsap} from "gsap"
    const herpSplit = 
    gsap.from(".hero-title", {
    y: 50,
    opacity: 0,
    duration: 1,
    ease: "power3.out"
  });

</script>