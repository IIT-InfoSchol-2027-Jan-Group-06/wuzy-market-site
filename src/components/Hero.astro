<section id="hero" class="relative flex min-h-screen items-center justify-center overflow-hidden px-5 pt-24 pb-20">
  <div class="w-full max-w-[1150px] text-center">
    <h1 class="hero-title font-control-compressed uppercase leading-[0.85] text-whiteout">
      <span class="block text-[clamp(56px,9vw,120px)]">every connection</span>
      <span class="block text-[clamp(56px,9vw,120px)]">
        has a <span class="font-control-cursive font-normal lowercase text-twilight-blue">
          <span id="cycle-word" class="font-control-cursive">story.</span>
        </span>
      </span>
    </h1>

    <p class="hero-copy mx-auto mt-6 max-w-xl text-base font-medium leading-relaxed text-whiteout/60">
      Wuzy matches you to communities, clubs and events that fit your vibe. Drop stories, grab
      tickets, and never walk in alone.
    </p>

    <div class="hero-cta mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#waitlist"
        class="btn-glass-yellow !rounded-full px-7"
      >
        Join the waitlist
      </a>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.hero-title span', {
    y: 60, opacity: 0, duration: 1, stagger: 0.12, ease: 'power4.out',
  });
  gsap.from('.hero-copy', { y: 24, opacity: 0, duration: 0.8, delay: 0.4, ease: 'power3.out' });
  gsap.from('.hero-cta a', { y: 16, opacity: 0, duration: 0.7, stagger: 0.12, delay: 0.55, ease: 'power3.out' });

  const words = ['story.', 'vibe.', 'crew.', 'home.', 'plan.', 'reason.'];
  let index = 0;
  const cycleWord = document.getElementById('cycle-word') as HTMLElement;

  const swap = () => {
    index = (index + 1) % words.length;
    gsap.to(cycleWord, {
      y: -30,
      opacity: 0,
      duration: 0.3,
      ease: 'power2.in',
      onComplete: () => {
        cycleWord.textContent = words[index];
        gsap.fromTo(
          cycleWord,
          { y: 30, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.4, ease: 'power2.out' }
        );
      },
    });
  };

  gsap.delayedCall(4, function repeat() {
    swap();
    gsap.delayedCall(2.6, repeat);
  });
</script>