---
// ── Frontmatter: independent feature lists per plan ──────────────────────────
// Each tier owns its own features array — editing one plan can never leak text
// into the other. Shape per item:
//   id            → stable key for the feature
//   label         → what the capability is
//   highlightText → bold callout rendered after the label (e.g. "Unlimited")
//   isIncluded    → true = active checkmark, false = greyed-out dash
const freeTierFeatures = [
  { id: 'connections', label: 'Ad-supported experience', isIncluded: true },
  { id: 'ads', label: 'Daily Connections', highlightText: '5 / Day', isIncluded: true },
  { id: 'spot-people', label: 'Limited to 1 event join per day', isIncluded: true },

  // ponytail: placeholder rows so the card has body — swap the copy when the
  // real premium feature set is settled. Shape is already correct.
  { id: 'ticket-dibs', label: 'Browse, buy, and secure tickets instantly', isIncluded: true },
  { id: 'discovery', label: 'Stay connected with the community', isIncluded: true },
];

// Everything in free, plus these — the upgrade list, edited independently.
const premiumTierFeatures = [
  { id: 'connections',  highlightText: '100% Ad-free experience', isIncluded: true },
  { id: 'ads', highlightText: 'Unlimited Daily Connections', isIncluded: true },
  { id: 'spot-people', highlightText: 'Unlimited event access', isIncluded: true },

  // ponytail: placeholder rows so the card has body — swap the copy when the
  // real premium feature set is settled. Shape is already correct.
  { id: 'ticket-dibs', highlightText: 'Unlock full guest list', isIncluded: true },
  { id: 'discovery', highlightText: 'Match with attendees who share your interests', isIncluded: true },
  { id: 'story-archive', label: 'Browse, buy, and secure tickets instantly', isIncluded: true },
  { id: 'event-tickets', label: 'Stay connected with the community', isIncluded: true },
];
---

<section id="pricing" class="relative scroll-mt-24 px-5 py-28">
  <div class="mx-auto w-full max-w-[980px]">
    <!-- Label -->
    <p class="pricing-label text-center text-sm font-medium uppercase tracking-[0.08em] text-ember">
      subscription
    </p>

    <!-- Headline (words reveal one-by-one, matching the other sections) -->
    <h2 class="mt-4 text-center font-display font-normal leading-[1.2] tracking-[0.02em] uppercase text-charcoal">
      <span class="block text-[clamp(38px,6vw,68px)]">
        {'unlock your'.split(' ').map((w) => (
          <span class="inline-block align-top">
            <span class="pricing-word inline-block will-change-transform">{w}&nbsp;</span>
          </span>
        ))}
      </span>
      <span class="block text-[clamp(38px,6vw,68px)]">
        <span class="pricing-word inline-block will-change-transform">
          <span class="font-control-cursive lowercase text-ember">main character era.</span>
        </span>
      </span>
    </h2>

    <!-- Sub copy -->
    <p class="pricing-desc mx-auto mt-5 max-w-lg text-center text-base font-normal leading-relaxed tracking-normal text-charcoal/70">
      Free lets you find the move. Premium gives you the guest list, unlimited matches, and zero ads.
    </p>

    <!-- ── Plan cards ───────────────────────────────────────────────────
         Side-by-side on desktop, stacked on mobile. The premium card is
         deliberately louder: ember hairline, warm fill, drop-glow, badged.

         Both cards stretch to the taller one's height and their feature
         lists take the slack (flex-1), so the two CTAs sit on the same
         baseline even though free lists five rows and premium seven. -->
    <div class="mt-14 grid grid-cols-1 gap-5 md:grid-cols-2 md:gap-6">

      <!-- ── Free ─────────────────────────────────────────────────────── -->
      <div class="pricing-card flex flex-col rounded-[24px] border border-white/10 bg-white/[0.03] p-7 shadow-card backdrop-blur-xl sm:p-8">
        <p class="text-sm font-medium uppercase tracking-[0.08em] text-steel">free</p>
        <p class="mt-3 flex items-baseline font-control text-[40px] font-light leading-none tracking-[-0.03em] text-charcoal">
          $0
        </p>
       

        <ul class="mt-7 flex-1 space-y-3.5">
          {freeTierFeatures.map((feature) => (
            <li class="flex items-center gap-3">
              {feature.isIncluded ? (
                <svg viewBox="0 0 20 20" fill="none" class="h-[18px] w-[18px] shrink-0 text-steel" aria-hidden="true">
                  <path d="M4.5 10.5l3.5 3.5 7.5-7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              ) : (
                <span class="flex h-[18px] w-[18px] shrink-0 items-center justify-center" aria-hidden="true">
                  <span class="h-px w-3.5 bg-charcoal/25"></span>
                </span>
              )}
              <span class={`text-[15px] leading-snug ${feature.isIncluded ? 'text-charcoal/85' : 'text-charcoal/35 line-through decoration-charcoal/20'}`}>
                {feature.label}
                {feature.highlightText && (
                  <span class={`font-medium text-steel ${feature.label ? 'ml-1.5' : ''}`}>{feature.label ? '— ' : ''}{feature.highlightText}</span>
                )}
              </span>
              <span class="sr-only">{feature.isIncluded ? 'included' : 'not included'}</span>
            </li>
          ))}
        </ul>

        <a
          href="#waitlist"
          class="mt-8 flex min-h-[46px] w-full items-center justify-center rounded-full border border-white/15 bg-white/[0.06] px-6 text-[15px] font-medium text-charcoal backdrop-blur-xl transition-colors hover:border-white/25 hover:bg-white/[0.1]"
        >
          get started
        </a>
      </div>

      <!-- ── Premium ──────────────────────────────────────────────────── -->
      <div class="pricing-card relative flex flex-col rounded-[24px] border border-ember/40 bg-ember/[0.05] p-7 shadow-[0_0_0_1px_rgba(255,231,131,0.12),0_24px_64px_-24px_rgba(255,231,131,0.28),0_24px_48px_-20px_rgba(0,0,0,0.9)] backdrop-blur-xl sm:p-8">
        <!-- Badge — a vibe, not a stat. No fabricated "most popular" claim. -->
        <span class="absolute -top-3 left-7 rounded-full border border-ember/50 bg-ember px-3 py-1 text-[11px] font-bold uppercase tracking-[0.1em] text-bone sm:left-8">
          the move
        </span>

        <p class="text-sm font-medium uppercase tracking-[0.08em] text-ember">premium</p>
        <p class="mt-3 flex items-baseline font-control text-[40px] font-light leading-none tracking-[-0.03em] text-charcoal">
          $10/month
        </p>

        <p class="mt-7 text-xs font-semibold uppercase tracking-[0.08em] text-charcoal/45">
          everything in free, plus
        </p>
        <ul class="mt-4 flex-1 space-y-3.5">
          {premiumTierFeatures.map((feature) => (
            <li class="flex items-center gap-3">
              {feature.isIncluded ? (
                <svg viewBox="0 0 20 20" fill="none" class="h-[18px] w-[18px] shrink-0 text-ember" aria-hidden="true">
                  <path d="M4.5 10.5l3.5 3.5 7.5-7.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              ) : (
                <span class="flex h-[18px] w-[18px] shrink-0 items-center justify-center" aria-hidden="true">
                  <span class="h-px w-3.5 bg-charcoal/25"></span>
                </span>
              )}
              <span class="text-[15px] leading-snug text-charcoal">
                {feature.label}
                {feature.highlightText && (
                  <span class={`font-semibold text-ember ${feature.label ? 'ml-1.5' : ''}`}>{feature.label ? '— ' : ''}{feature.highlightText}</span>
                )}
              </span>
              <span class="sr-only">{feature.isIncluded ? 'included' : 'not included'}</span>
            </li>
          ))}
        </ul>

        <a
          href="#waitlist"
          class="mt-8 flex min-h-[46px] w-full items-center justify-center rounded-full border border-ember/50 bg-ember/[0.12] px-6 text-[15px] font-medium text-ember backdrop-blur-xl transition-colors hover:border-ember/70 hover:bg-ember/[0.2]"
        >
          put me on the list
        </a>
      </div>
    </div>

    <!-- Honest urgency: this genuinely is a pre-launch waitlist. No countdown
         timers, no invented signup counts — fabricated scarcity reads as fake. -->
    
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // Label fades in.
  gsap.from('.pricing-label', {
    y: 24,
    autoAlpha: 0,
    duration: 0.7,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.pricing-label', start: 'top 85%', once: true },
  });

  // Headline words rise into place.
  const words = gsap.utils.toArray<HTMLElement>('.pricing-word');
  if (words.length) {
    gsap.from(words, {
      yPercent: 110,
      autoAlpha: 0,
      rotate: 4,
      duration: 0.9,
      stagger: 0.09,
      ease: 'power4.out',
      scrollTrigger: { trigger: '.pricing-label', start: 'top 80%', once: true },
    });
  }

  // Sub-copy and closing note.
  gsap.from('.pricing-desc, .pricing-note', {
    y: 30,
    autoAlpha: 0,
    duration: 0.8,
    stagger: 0.12,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.pricing-desc', start: 'top 88%', once: true },
  });

  // Cards rise in, premium a beat after free.
  const cards = gsap.utils.toArray<HTMLElement>('.pricing-card');
  if (cards.length) {
    gsap.from(cards, {
      y: 40,
      autoAlpha: 0,
      duration: 0.8,
      stagger: 0.14,
      ease: 'power3.out',
      scrollTrigger: { trigger: '.pricing-card', start: 'top 85%', once: true },
    });
  }
</script>
