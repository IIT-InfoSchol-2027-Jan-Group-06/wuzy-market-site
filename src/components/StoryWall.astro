---
import { stubs } from '../data/site';
const perf = 'radial-gradient(circle at 8px 50%, transparent 6px, #000 6.5px), radial-gradient(circle at calc(100% - 8px) 50%, transparent 6px, #000 6.5px)';
---
<section class="mx-auto max-w-6xl px-5 py-28">
  <h2 class="font-display text-[clamp(2.2rem,8vw,6rem)] leading-none text-ink">EVERY CONNECTION HAS A STORY.</h2>
  <p class="mt-4 text-mute">here are some of the ones we have heard so far.</p>

  <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {stubs.map(s => (
      <article
        class="reveal group overflow-hidden rounded-lg bg-void-2 transition-transform duration-300 hover:-rotate-2"
        style={`-webkit-mask-image:${perf};mask-image:${perf};-webkit-mask-composite:source-in;mask-composite:intersect`}
      >
        <img src={s.img} alt="" loading="lazy" width="640" height="420" class="h-44 w-full object-cover grayscale-[35%] group-hover:grayscale-0" />
        <div class="border-t border-dashed border-olive-edge p-5">
          <p class="font-display text-lg lowercase text-butter">{s.name}</p>
          <p class="font-mono text-xs text-butter-dim">{s.date}</p>
          <p class="mt-3 text-sm italic text-mute">{s.note}</p>
        </div>
      </article>
    ))}
  </div>
</section>
