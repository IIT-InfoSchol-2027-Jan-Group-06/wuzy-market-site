---
// The enterprise "why host on wuzy" section, restyled to match the homepage's
// "Why Choose" section (YSCard.astro): a pinned scroll area where the locked
// heading stays centered while the cards rise over it one by one, then the
// whole thing fades out before the pin releases.
//
// The content is the host pitch (target, sales, retention). The card is
// YSCard's exactly — surface, padding, hover lift, scrubbed entrance, and
// title-then-body with no figure, so the two card sets read as one family.
//
// It is a separate component rather than a prop on YSCard because that
// component's script reads `#ys-cycle-word` by id and cycles "wuzy./us." —
// wrong for this section, and its selectors are global.
//
// Class prefix is whyhost-* so it can never collide with the homepage's ys-*.
const reasons = [
  {
    t: 'Target Audience Reach',
    d: 'We skip generic feeds and deliver your event directly to local users who share your specific vibe, ensuring you fill the room with an engaged crowd.',
  },
  {
    t: 'Built-In Audience Growth',
    d: 'Convert one-time ticket buyers into a loyal community, keeping your crowd connected and ready for your next event.',
  },
];
---

<section id="why-host" class="relative">
  <!-- Pinned scroll area: heading stays locked in the center while the
       cards rise up over it one by one, exactly like the homepage #
       "why choose" section. -->
  <div class="whyhost-scroll relative">
    <div class="whyhost-sticky relative flex min-h-svh w-full flex-col items-center justify-center overflow-hidden px-5">
      <!-- Centered like YSCard. It used to be lifted 30vh with a negative
           margin under the grid, which just moved the slack to the bottom and
           read as a blank band before the host waitlist. -->
      <div class="whyhost-inner flex w-full flex-col items-center justify-center">
      <!-- Locked, centered heading — kept on top of the rising cards so the
         title always stays readable. -->
      <div class="whyhost-head relative z-20 mx-auto max-w-5xl text-center">
        <h2 class="font-display uppercase text-display font-normal leading-[1.2] tracking-[0.02em] text-charcoal">
          why host on wuzy
        </h2>
      </div>

      <!-- Cards rise one-by-one below the heading as the user scrolls, reusing
             the YSCard surface, padding, radius and hover lift. -->
      <div class="whyhost-grid relative z-10 mt-16 grid w-full max-w-[1200px] gap-7 md:grid-cols-2 lg:mt-20">
        {reasons.map((r) => (
          <div class="whyhost-card rounded-[24px] border border-white/10 bg-[#10100e]/85 p-9 shadow-card">
            <div class="transition-transform duration-300 hover:-translate-y-2">
              <h3 class="font-display text-2xl font-normal tracking-[0.02em] text-charcoal">
                {r.t}
              </h3>
              <p class="whyhost-body mt-3 text-[15px] font-normal leading-relaxed tracking-[-0.01em] text-charcoal/70">
                {r.d}
              </p>
            </div>
          </div>
        ))}
      </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { pinScale } from '../lib/scroll';

  gsap.registerPlugin(ScrollTrigger);

  // Pinned, scroll-scrubbed timeline — the exact beat YSCard runs: heading
  // locked, cards rising one by one, a hold, then everything fades out before
  // the pin releases so the waitlist never arrives on top of leftovers.
  const scroller = document.querySelector<HTMLElement>('.whyhost-scroll');
  const sticky = document.querySelector<HTMLElement>('.whyhost-sticky');
  const cards = gsap.utils.toArray<HTMLElement>('.whyhost-card');

  if (cards.length && scroller && sticky) {
    // ~0.45 viewport per card for the build-up, then the finished stack is
    // held for HOLD_VH — the same beat the other pinned sections hold for.
    const buildVH = 0.35 + cards.length * 0.45;
    const HOLD_VH = 1.2;

    // Initial state for entrance animation
    gsap.set(cards, { y: 200, x: (i) => (i % 2 === 0 ? -70 : 70), rotate: (i) => (i % 2 === 0 ? -4 : 4), autoAlpha: 0 });

    // The heading rises while the section scrolls into view, so it pins with
    // the heading already up instead of arriving blank.
    gsap.from('.whyhost-head', {
      y: 50,
      autoAlpha: 0,
      ease: 'power3.out',
      scrollTrigger: { trigger: scroller, start: 'top bottom', end: 'top center', scrub: true },
    });

    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: scroller,
        start: 'top top',
        end: () => '+=' + (buildVH + HOLD_VH) * pinScale() * window.innerHeight,
        pin: sticky,
        scrub: true,
        anticipatePin: 1,
      },
    });

    // Scrubbed timeline: cards rise one by one as user scrolls
    cards.forEach((card, i) => {
      tl.fromTo(
        card,
        { y: 200, x: i % 2 === 0 ? -70 : 70, rotate: i % 2 === 0 ? -4 : 4, autoAlpha: 0 },
        { y: 0, x: 0, rotate: 0, autoAlpha: 1, duration: 0.8, ease: 'power2.out' }
      );
    });

    // Hold the finished stack, then let it scroll off under the host waitlist.
    // No fade-out: fading while pinned left a blank screen before it arrived.
    tl.to({}, { duration: HOLD_VH });
  }
</script>

<style>
  /* ── Small screens ────────────────────────────────────────────
     Below md the two cards stack into one column; shrink card padding and
     keep the gap so the whole column fits a short phone viewport (the heading
     steps down with the type tiers in global.css). Mirrors the YSCard
     treatment, scoped to .whyhost-body so the rule cannot reach the heading. */
  @media (max-width: 767px) {
    .whyhost-grid {
      margin-top: 1.25rem !important;
      gap: 1rem;
    }

    .whyhost-card { padding: 1.4rem; }
    .whyhost-card h3 { font-size: 1.25rem; }
    .whyhost-card .whyhost-body { font-size: 14px; margin-top: 0.5rem; }
  }
</style>