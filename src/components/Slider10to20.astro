<section class="relative mx-auto max-w-5xl px-5 py-28">
  <h2 class="font-display text-[clamp(2rem,6vw,4rem)] lowercase text-ink">how many people is the right number?</h2>

  <div class="relative mt-10 aspect-[16/10] overflow-hidden rounded-card">
    <img src="/media/crowd-14.jpg" alt="Fourteen people at a rooftop table" class="absolute inset-0 h-full w-full object-cover" />
    <img id="crowd" src="/media/crowd-500.jpg" alt="" aria-hidden="true" class="absolute inset-0 h-full w-full object-cover" />
    <p id="crowdLine" class="absolute bottom-5 left-5 max-w-sm font-display text-2xl lowercase text-butter drop-shadow-[0_2px_12px_rgba(7,12,26,0.9)]">a room where nobody notices you came.</p>
  </div>

  <div class="mt-8">
    <div class="flex items-baseline justify-between font-mono text-sm text-mute">
      <span id="crowdNum" class="text-butter">500</span><span>drag down</span>
    </div>
    <input id="crowdRange" type="range" min="12" max="500" value="500" aria-label="Group size"
      class="mt-3 h-2 w-full cursor-pointer appearance-none rounded-full bg-void-3" />
    <p id="capTip" class="mt-3 font-mono text-xs text-butter opacity-0 transition-opacity">every Wuzy event caps at 20. that is not a limit, that is the feature.</p>
  </div>

  <p class="mt-10 max-w-md text-lg text-mute">Big enough that it is not awkward. Small enough that you are not furniture.</p>
</section>

<script>
  const CAP = 20;
  const r = document.getElementById('crowdRange') as HTMLInputElement;
  const img = document.getElementById('crowd') as HTMLImageElement;
  const num = document.getElementById('crowdNum')!;
  const line = document.getElementById('crowdLine')!;
  const tip = document.getElementById('capTip')!;

  const sync = () => {
    let v = +r.value;
    // detent: anything inside the cap band lands on 20, so the limit is felt not read
    if (v > CAP && v <= CAP + 14) { v = CAP; r.value = String(v); }
    img.style.opacity = String(Math.min(1, Math.max(0, (v - CAP) / (500 - CAP))));
    num.textContent = String(v);
    r.setAttribute('aria-valuetext', `${v} people`);
    line.textContent = v <= CAP ? "a room where they notice if you don't." : 'a room where nobody notices you came.';
    tip.style.opacity = v <= CAP ? '1' : '0';
  };
  r.addEventListener('input', sync); sync();
</script>
