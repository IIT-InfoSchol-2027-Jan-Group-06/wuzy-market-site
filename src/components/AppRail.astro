---
import { screens } from '../data/site';
---
<section id="rail" class="py-24">
  <div class="mx-auto flex max-w-6xl snap-x snap-mandatory gap-6 overflow-x-auto px-5 pb-6 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {screens.map((s, i) => (
      <figure class="w-[260px] shrink-0 snap-center">
        <div class="overflow-hidden rounded-[28px] border-4 border-void-3 bg-black">
          <img src={s.src} alt={s.cap} loading="lazy" width="540" height="1170" class="w-full" />
        </div>
        <figcaption class="mt-3 text-sm text-mute">
          <span class="font-mono text-butter-dim">[{i + 1}]</span> {s.cap}
        </figcaption>
      </figure>
    ))}
  </div>
</section>
