---
import { negations } from '../data/site';
---
<section id="how" class="mx-auto max-w-4xl px-5 py-32">
  <ul class="space-y-4 font-display text-[clamp(1.6rem,5vw,3.5rem)] lowercase leading-tight text-mute">
    {negations.map(l => (
      <li class="reveal strike w-fit">{l}</li>
    ))}
  </ul>
  <p class="reveal mt-12 font-display text-[clamp(1.8rem,5.5vw,4rem)] lowercase leading-tight text-butter">
    just a reason to be in the same room.
  </p>
</section>
