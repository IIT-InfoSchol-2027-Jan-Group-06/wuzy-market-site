---
const { opts, name } = Astro.props;
---
<button
  type="button"
  data-chip={name}
  data-opts={JSON.stringify(opts)}
  aria-label={`change ${name}, currently ${opts[0]}`}
  class="inline-block px-3 py-0.5 bg-butter text-void border-2 border-butter-deep rounded-lg hover:bg-butter-deep active:translate-y-px transition-colors"
>{opts[0]}</button>
