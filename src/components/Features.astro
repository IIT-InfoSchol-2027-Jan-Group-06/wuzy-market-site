---
// ── Frontmatter: data used to render the section ─────────────────────────────
// Live phone mockups — a real bezel, a natively scrollable screen, and UI
// pieces that float over the page until the screen is scrolled, at which point
// they fly home into the slots they were cut from. See ./mockups/WuzyFrame.astro.
import FeedFrame from './mockups/FeedFrame.astro';
import DiscoverFrame from './mockups/DiscoverFrame.astro';
import TicketFrame from './mockups/TicketFrame.astro';
import ChatFrame from './mockups/ChatFrame.astro';

// The 4 feature "slides". Each maps to a pinned screen:
//   t    → slide headline
//   d    → slide sub-copy
//   Mock → the live phone frame shown next to the headline
const features = [
  { t: 'Catch Up With Friends', d: 'Check social feeds, plan meetups, and make a scene.', Mock: FeedFrame },
  { t: 'Find Events, Communities & Join', d: 'Discover local events and communities that match your interests, and pull up in one tap.', Mock: DiscoverFrame },
  { t: 'Direct in-app Ticketing', d: 'Purchase tickets in seconds and keep all your passes saved in one place with zero redirects.', Mock: TicketFrame },
  { t: 'Conversations under one roof', d: 'Message people directly or connect in community chats without switching apps.', Mock: ChatFrame },
];
---

<section id="features" class="relative">
  <!-- ── Pinned scroll area (intro + feature slides) ──────────────────────
       This whole block is pinned by ScrollTrigger so it stays on screen
       while you scroll. The intro text fades out, then the 4 slides
       crossfade one into the next. -->
  <div class="feature-scroll relative">
    <div class="feature-sticky flex min-h-screen items-center justify-center overflow-hidden uppercase">

      <!-- ── Intro overlay: "Everything your crew needs…" ──────────────────
           Absolutely positioned over the slides. Words start grey and are
           lit up white one-by-one as you scroll (.intro-lit is animated). -->
      <div class="feature-intro pointer-events-none absolute inset-0 z-10 flex items-center justify-center px-5 pb-16">
        <div class="mx-auto w-full max-w-[1150px] text-center">
          <h2 class="mx-auto max-w-3xl font-display text-[clamp(30px,4.5vw,56px)] font-normal leading-[1.2] tracking-[0.02em] text-charcoal uppercase">
            <!-- Split the headline into per-word spans so each word can animate
                 independently. No will-change here: these only ever receive a
                 colour tween, and seventeen permanently-promoted layers is the
                 exact thing the note on .feature-sticky in global.css warns
                 against. -->
            {'everything you need in one app. events, tickets, communities, and the connections you don\'t want to'.split(' ').map((w) => (
              <span class="inline-block align-top">
                <!-- intro-lit → the word gets its color tweened by GSAP -->
                <span class="intro-lit inline-block text-charcoal/40">{w}&nbsp;</span>
              </span>
            ))}
            <!-- Trailing cursive word "miss." in brand yellow (starts dim, lights yellow) -->
            <span class="inline-block align-top">
              <span class="intro-lit inline-block text-charcoal/40">
                <span class="intro-blue font-control-cursive lowercase">miss.</span>
              </span>
            </span>
          </h2>
        </div>
      </div>

      <!-- ── Feature slides ─────────────────────────────────────────────────
           All slides are absolutely positioned on top of each other.
           GSAP controls visibility: only one is visible at a time. -->
      <div class="mx-auto flex w-full max-w-[1150px] items-center px-5">
        {features.map((f) => (
          <div class="feature-slide pointer-events-none absolute inset-x-0 mx-auto w-full max-w-[1150px] px-5">
            <!-- `1fr auto` rather than an even split: the phone's floating
               pieces hang past both edges of the frame (--x runs -9% … 103%),
               so the visual column has to size to its content and carry a
               gutter, or the left-hand floats land on the headline.
               Side-by-side starts at xl, not lg: with a 318px phone plus its
               gutters the copy track is only ~600px at 1024, and the headline
               ran straight under the breakouts. Below that, stacked. -->
          <div class="grid items-center gap-10 xl:grid-cols-[1fr_auto]">
              <!-- Left: headline + description (moves below visual on mobile) -->
              <div class="feature-copy order-2 min-w-0 xl:order-1">
                <h3 class="feature-title mt-4 font-display text-[clamp(36px,6vw,80px)] font-normal leading-[1.2] tracking-[0.02em] text-charcoal">
                  <!-- Split headline into words so GSAP can stagger them in -->
                  {f.t.split(' ').map((w) => (
                    <span class="inline-block align-top">
                      <span class="feature-word inline-block will-change-transform">{w}&nbsp;</span>
                    </span>
                  ))}
                </h3>
                <p class="feature-desc mt-5 max-w-md text-base font-normal leading-relaxed tracking-[-0.01em] text-charcoal/70">
                  {f.d}
                </p>
              </div>
              <!-- Right: the live phone. No perspective here — .wz sets its
                   own, and the breakouts need the gutter more than the depth. -->
              <div class="feature-visual order-1 flex justify-center px-[clamp(16px,5vw,92px)] xl:order-2">
                <f.Mock />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { pinScale } from '../lib/scroll';

  gsap.registerPlugin(ScrollTrigger);

  // ── Main pinned timeline (intro text + 4 slides) ───────────────────────────
  const slides = gsap.utils.toArray<HTMLElement>('.feature-slide');
  const scroller = document.querySelector<HTMLElement>('.feature-scroll'); // trigger element
  const sticky = document.querySelector<HTMLElement>('.feature-sticky');   // element that gets pinned
  const intro = document.querySelector<HTMLElement>('.feature-intro');     // intro overlay
  const lit = gsap.utils.toArray<HTMLElement>('.intro-lit');               // words to light up

  if (slides.length && sticky) {
    // Timeline "time" is mapped to scroll distance via scrub.
    // wordStep = seconds of timeline per word lit up (also ~scroll amount).
    const wordStep = 0.14;
    // Seconds a finished beat sits on screen before the next one starts —
    // the fully lit headline, and each mockup. Without it the next thing
    // begins the moment the last one lands, so everything swaps the instant
    // you scroll instead of holding.
    const dwell = 2.9;
    // A slide's hold is no longer dead time: it is two beats the same page
    // scroll drives, back to back.
    //   homeDur  — the breakouts fly out of the page and into their slots
    //   screenDur — then the screen itself scrolls its whole runway
    // Only once both have finished does the slide hand off to the next one.
    // Nobody has to find the phone and scroll it by hand.
    const homeDur = 0.9;
    const screenDur = dwell;
    // Intro beats: every word lit, then held, then faded out.
    const introLit = lit.length * wordStep;
    const introFadeAt = introLit + dwell;
    const introDur = introFadeAt + wordStep * 3;

    // Attach the two beats to a slide, right after its entrance.
    // `.wz-well` scrolls natively on its own; here the timeline owns it, so
    // the manual affordance comes off — otherwise a wheel over the phone and
    // the scrub fight each other for scrollTop.
    const drive = (s: HTMLElement) => {
      const wz = s.querySelector<HTMLElement>('.wz');
      const well = s.querySelector<HTMLElement>('.wz-well');
      if (!wz || !well) return;
      well.style.overflowY = 'hidden';
      well.removeAttribute('tabindex');
      well.removeAttribute('role');
      const p = { h: 0, s: 0 };
      // Keep the last fraction rather than only the pixel value. The runway
      // changes with the frame width, and a scrub tween that has already
      // finished never fires onUpdate again — so after a resize the screen was
      // left parked at a scrollTop measured against the old runway.
      const apply = () => {
        well.scrollTop = p.s * (well.scrollHeight - well.clientHeight);
      };
      window.addEventListener('resize', apply);
      tl.fromTo(
        p,
        { h: 0 },
        {
          h: 1, duration: homeDur, ease: 'power2.inOut',
          onUpdate: () => (wz as any).wzHome?.(p.h),
        },
        '<0.45'   // overlap the tail of the entrance, don't wait for it
      ).fromTo(
        p,
        { s: 0 },
        {
          s: 1, duration: screenDur, ease: 'none',
          // Measured per frame, not once: the runway tracks the frame width.
          onUpdate: apply,
        }
      );
    };

    // Hide every slide (and its inner parts) up front, so GSAP owns visibility.
    slides.forEach((s) => {
      const words = s.querySelectorAll<HTMLElement>('.feature-word');
      const desc = s.querySelector<HTMLElement>('.feature-desc');
      const img = s.querySelector<HTMLElement>('.feature-visual .wz');

      gsap.set(s, { scale: 0.7, autoAlpha: 0 });
      gsap.set(words, { autoAlpha: 0, y: 70, rotate: 5 });
      gsap.set(desc, { autoAlpha: 0, y: 45 });
      gsap.set(img, { autoAlpha: 0, scale: 0.7 });
    });

    // The pinned timeline: pins .feature-sticky while the user scrolls.
    // The whole sequence (intro words + 4 slides) is scrubbed across this
    // distance, so it has to be budgeted per item — same as Community/YSCard.
    // Budget terms, not measured output: they land the intro words at ~1.05
    // viewports and each mockup at ~2.8 — roughly half a viewport of entrance,
    // then the breakouts seating and the screen running its length. These are
    // the pacing knobs; lower them if the section drags.
    // Scrub splits the distance by timeline time, so the budget alone does
    // not set the split — wordStep, homeDur and screenDur above are what keep
    // the intro, the transitions and the phone beats at those shares.
    // With default pinSpacing the spacer equals the pin distance, so the pin
    // releases with Community's top exactly at the viewport top — no gap.
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: scroller,
        start: 'top top',
        end: () =>
          '+=' + (2.4 + slides.length * 2.8) * pinScale() * window.innerHeight,
        pin: sticky,
        scrub: true,        // progress follows scroll 1:1
        anticipatePin: 1,
      },
    });

    // Phase 1 — light up the intro words one by one (grey → white / blue).
    lit.forEach((w, i) => {
      const inner = w.querySelector('span') || w;
      const target =
        inner.classList.contains('intro-blue')
          ? '#ffe783'      // "miss." → brand yellow
          : '#f4efd4';     // everything else → warm cream
      tl.to(inner, { color: target, duration: wordStep }, i * wordStep);
    });

    // Phase 2 — fade the intro overlay out (slightly upward).
    tl.to(
      intro,
      {
        autoAlpha: 0,
        yPercent: -10,
        duration: wordStep * 3,
        ease: 'power1.inOut',
      },
      introFadeAt
    );

    // Phase 3 — bring in the FIRST slide right as the intro fades.
    const first = slides[0];
    const firstWords = first.querySelectorAll<HTMLElement>('.feature-word');
    const firstDesc = first.querySelector<HTMLElement>('.feature-desc');
    const firstImg = first.querySelector<HTMLElement>('.feature-visual .wz');

    tl.fromTo(
      first,
      { scale: 0.7, autoAlpha: 0 },
      { scale: 1, autoAlpha: 1, duration: 0.45, ease: 'power2.out' },
      introDur - 0.2   // start slightly before the intro finishes fading
    )
      .fromTo(
        firstWords,
        { autoAlpha: 0, y: 75, rotate: 6 },
        { autoAlpha: 1, y: 0, rotate: 0, duration: 0.45, ease: 'power3.out', stagger: 0.07 },
        '<0.2'   // '<' = relative to previous tween's start, +0.2s
      )
      .fromTo(firstDesc, { autoAlpha: 0, y: 50 }, { autoAlpha: 1, y: 0, duration: 0.45, ease: 'power3.out' }, '<0.3')
      .fromTo(firstImg, { autoAlpha: 0, scale: 0.7 }, { autoAlpha: 1, scale: 1, duration: 0.45, ease: 'power3.out' }, '<0.15');

    drive(first);

    // Phase 4 — for each following slide: hide the previous one, show the next.
    slides.forEach((s, i) => {
      if (i === 0) return;
      const prev = slides[i - 1];
      const prevWords = prev.querySelectorAll<HTMLElement>('.feature-word');
      const prevDesc = prev.querySelector<HTMLElement>('.feature-desc');
      const prevImg = prev.querySelector<HTMLElement>('.feature-visual .wz');

      const words = s.querySelectorAll<HTMLElement>('.feature-word');
      const desc = s.querySelector<HTMLElement>('.feature-desc');
      const img = s.querySelector<HTMLElement>('.feature-visual .wz');

      // Exit the previous slide — children first, and the container's own fade
      // LAST. It used to fade first, which put the slide at visibility:hidden
      // 0.7s before its words/desc/image had finished animating: the exit
      // choreography was never actually seen, and the pinned screen sat blank
      // until the next slide began.
      // No '+=' hold in front of it any more: drive() has just spent homeDur +
      // screenDur seating the breakouts and scrolling the screen, so the exit
      // starts the moment that finishes. That is the whole point — one scroll
      // runs the phone and then moves on, with no dead beat in between.
      tl.to(
        prevWords,
        { y: -70, rotate: -5, autoAlpha: 0, duration: 0.45, ease: 'power2.in', stagger: 0.04 },
        '+=0.15'
      )
        .to(prevDesc, { y: -45, autoAlpha: 0, duration: 0.45, ease: 'power2.in' }, '<0.1')
        .to(
          prevImg,
          { scale: 0.6, autoAlpha: 0, duration: 0.45, ease: 'power2.in' },
          '<0.1'
        )
        .to(prev, { scale: 0.7, autoAlpha: 0, duration: 0.45, ease: 'power2.in' }, '<0.15')
        // …then the entrance animation for the current slide, overlapping the
        // tail of the exit so the hand-off crossfades instead of going blank.
        .fromTo(
          s,
          { scale: 0.7, autoAlpha: 0 },
          { scale: 1, autoAlpha: 1, duration: 0.45, ease: 'power2.out' },
          '<0.35'
        )
        .fromTo(
          words,
          { autoAlpha: 0, y: 75, rotate: 6 },
          { autoAlpha: 1, y: 0, rotate: 0, duration: 0.45, ease: 'power3.out', stagger: 0.07 },
          '<0.2'
        )
        .fromTo(desc, { autoAlpha: 0, y: 50 }, { autoAlpha: 1, y: 0, duration: 0.45, ease: 'power3.out' }, '<0.3')
        .fromTo(
          img,
          { autoAlpha: 0, scale: 0.7 },
          { autoAlpha: 1, scale: 1, duration: 0.45, ease: 'power3.out' },
          '<0.15'
        );

      drive(s);
    });

    // Phase 5 — fade out the LAST slide before the pin releases, so it's gone
    // before Community arrives. Then a brief hold to keep timing smooth.
    const last = slides[slides.length - 1];
    const lastWords = last.querySelectorAll<HTMLElement>('.feature-word');
    const lastDesc = last.querySelector<HTMLElement>('.feature-desc');
    const lastImg = last.querySelector<HTMLElement>('.feature-visual .wz');

    tl.to(
      lastWords,
      { y: -70, rotate: -5, autoAlpha: 0, duration: 0.45, ease: 'power2.in', stagger: 0.04 },
      '+=0.15'
    )
      .to(lastDesc, { y: -45, autoAlpha: 0, duration: 0.45, ease: 'power2.in' }, '<0.1')
      .to(
        lastImg,
        { scale: 0.6, autoAlpha: 0, duration: 0.45, ease: 'power2.in' },
        '<0.1'
      )
      .to(last, { scale: 0.7, autoAlpha: 0, duration: 0.45, ease: 'power2.in' }, '<0.15')
      .to({}, { duration: 0.3 });
  }
</script>