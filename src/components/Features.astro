---
// ── Frontmatter: data used to render the section ─────────────────────────────
// Phone mockup images (added locally to the build via Vite/Astro imports)
import homeMock from '../assets/mockups/home.png';
import eventMock from '../assets/mockups/event-info.png';
import profileMock from '../assets/mockups/profile.png';
import progressMock from '../assets/mockups/progress.png';

// The 4 feature "slides". Each maps to a pinned screen:
//   n   → slide number label
//   e   → emoji (kept here for reference, not rendered)
//   t   → slide headline
//   d   → slide sub-copy
//   mock → the phone screenshot shown next to the headline
const features = [
  { n: '01', e: '📸', t: 'Catch Up With Friends', d: 'Check social feeds, plan meetups, and make a scene.', mock: homeMock },
  { n: '02', e: '🎟️', t: 'Find Events,Communities & Join', d: 'Discover local events and communities that match your interests, and pull up in one tap.', mock: eventMock },
  { n: '03', e: '🌍', t: 'Event Discovery & Ticketing', d: 'Discover local events, buy event tickets directly in-app, and check the guest list to see who’s going.', mock: progressMock },
  { n: '04', e: '🤝', t: 'Gamified Rewards', d: 'Earn badges and in-app coins every time you make a real connection and show up to events.', mock: profileMock },
];
---

<section id="features" class="features-grad relative">
  <!-- ── Pinned scroll area (intro + feature slides) ──────────────────────
       This whole block is pinned by ScrollTrigger so it stays on screen
       while you scroll. The intro text fades out, then the 4 slides
       crossfade one into the next. -->
  <div class="feature-scroll relative">
    <div class="feature-sticky flex min-h-screen items-center justify-center overflow-hidden uppercase">

      <!-- ── Intro overlay: "Everything your crew needs…" ──────────────────
           Absolutely positioned over the slides. Words start grey and are
           lit up white one-by-one as you scroll (.intro-lit is animated). -->
      <div class="feature-intro pointer-events-none absolute inset-0 z-10 flex items-center justify-center px-5 pb-16">
        <div class="mx-auto w-full max-w-[1150px] text-center">
          <h2 class="mx-auto max-w-3xl font-display text-[clamp(30px,4.5vw,56px)] font-normal leading-[1.2] tracking-[0.02em] text-charcoal">
            <!-- Split the headline into per-word spans so each word can animate independently -->
            {'EVERYTHING YOU NEED IN ONE APP. EVENTS, TICKETS, COMMUNITIES, AND THE CONNECTIONS YOU DONT WANT TO'.split(' ').map((w) => (
              <span class="inline-block align-top">
                <!-- intro-lit → the word gets its color tweened by GSAP -->
                <span class="intro-word intro-lit inline-block will-change-transform text-charcoal/40">{w}&nbsp;</span>
              </span>
            ))}
            <!-- Trailing cursive word "miss." in brand yellow (starts dim, lights yellow) -->
            <span class="inline-block align-top">
              <span class="intro-word intro-lit inline-block will-change-transform text-charcoal/40">
                <span class="intro-blue font-control-cursive lowercase text-ember">miss.</span>
              </span>
            </span>
          </h2>
          <!-- Sub-copy under the headline (also word-split, but not color-animated) -->
          
          
        </div>
      </div>

      <!-- ── Feature slides ─────────────────────────────────────────────────
           All slides are absolutely positioned on top of each other.
           GSAP controls visibility: only one is visible at a time. -->
      <div class="mx-auto flex w-full max-w-[1150px] items-center px-5">
        {features.map((f) => (
          <div class="feature-slide pointer-events-none absolute inset-x-0 mx-auto w-full max-w-[1150px] px-5">
            <div class="grid items-center gap-10 lg:grid-cols-2">
              <!-- Left: headline + description (moves below visual on mobile) -->
              <div class="feature-copy order-2 lg:order-1">
                <h3 class="feature-title mt-4 font-display text-[clamp(36px,6vw,80px)] font-normal leading-[1.2] tracking-[0.02em] text-charcoal">
                  <!-- Split headline into words so GSAP can stagger them in -->
                  {f.t.split(' ').map((w) => (
                    <span class="inline-block align-top">
                      <span class="feature-word inline-block will-change-transform">{w}&nbsp;</span>
                    </span>
                  ))}
                </h3>
                <p class="feature-desc mt-5 max-w-md text-base font-normal leading-relaxed tracking-[-0.01em] text-charcoal/70">
                  {f.d}
                </p>
              </div>
              <!-- Right: phone mockup screenshot -->
              <div class="feature-visual order-1 flex justify-center [perspective:1200px] lg:order-2">
                <img
                  src={f.mock.src}
                  alt={f.t}
                  class="w-60 max-w-[50vw] object-cover"
                />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // ── Simple scroll-reveal for elements marked .reveal (the whole-plan block) ──
  gsap.utils.toArray<HTMLElement>('.reveal').forEach((el) => {
    gsap.from(el, {
      y: 40,
      opacity: 0,
      duration: 0.9,
      ease: 'power3.out',
      scrollTrigger: { trigger: el, start: 'top 80%', once: true },
    });
  });

  // ── Main pinned timeline (intro text + 4 slides) ───────────────────────────
  const slides = gsap.utils.toArray<HTMLElement>('.feature-slide');
  const scroller = document.querySelector<HTMLElement>('.feature-scroll'); // trigger element
  const sticky = document.querySelector<HTMLElement>('.feature-sticky');   // element that gets pinned
  const intro = document.querySelector<HTMLElement>('.feature-intro');     // intro overlay
  const lit = gsap.utils.toArray<HTMLElement>('.intro-lit');               // words to light up

  if (slides.length && sticky) {
    // Timeline "time" is mapped to scroll distance via scrub.
    // wordStep = seconds of timeline per word lit up (also ~scroll amount).
    const wordStep = 0.15;
    // Total time the intro takes: light up every word + 3 steps to fade out.
    const introDur = lit.length * wordStep + wordStep * 3;

    // Reveal the intro as the section scrolls into view after the hero.
    gsap.from('.feature-intro h2, .feature-intro p', {
      y: 50,
      autoAlpha: 0,
      duration: 1,
      stagger: 0.3,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: scroller,
        start: 'top 85%',
        once: true,
      },
    });

    // Hide every slide (and its inner parts) up front, so GSAP owns visibility.
    slides.forEach((s) => {
      const words = s.querySelectorAll<HTMLElement>('.feature-word');
      const desc = s.querySelector<HTMLElement>('.feature-desc');
      const img = s.querySelector<HTMLElement>('.feature-visual img');

      gsap.set(s, { scale: 0.7, autoAlpha: 0, filter: 'blur(10px)' });
      gsap.set(words, { autoAlpha: 0, y: 70, rotate: 5 });
      gsap.set(desc, { autoAlpha: 0, y: 45 });
      gsap.set(img, { autoAlpha: 0, scale: 0.7 });
    });

    // The pinned timeline: pins .feature-sticky while the user scrolls.
    // end = total scroll distance the pin lasts (intro + one viewport per slide).
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: scroller,
        start: 'center center',
        end: () => '+=' + (introDur + slides.length * 0.6) * window.innerHeight,
        pin: sticky,
        scrub: true,        // progress follows scroll 1:1
        anticipatePin: 1,
      },
    });

    // Phase 1 — light up the intro words one by one (grey → white / blue).
    lit.forEach((w, i) => {
      const inner = w.querySelector('span') || w;
      const target =
        inner.classList.contains('intro-blue')
          ? '#ffe783'      // "miss." → brand yellow
          : '#f4efd4';     // everything else → warm cream
      tl.to(inner, { color: target, duration: wordStep }, i * wordStep);
    });

    // Phase 2 — fade the intro overlay out (slightly upward).
    tl.to(
      intro,
      {
        autoAlpha: 0,
        yPercent: -10,
        duration: wordStep * 3,
        ease: 'power1.inOut',
      },
      (lit.length - 1) * wordStep
    );

    // Phase 3 — bring in the FIRST slide right as the intro fades.
    const first = slides[0];
    const firstWords = first.querySelectorAll<HTMLElement>('.feature-word');
    const firstDesc = first.querySelector<HTMLElement>('.feature-desc');
    const firstImg = first.querySelector<HTMLElement>('.feature-visual img');

    tl.fromTo(
      first,
      { scale: 0.7, autoAlpha: 0, filter: 'blur(10px)' },
      { scale: 1, autoAlpha: 1, filter: 'blur(0px)', duration: 0.6, ease: 'power2.out' },
      introDur - 0.2   // start slightly before the intro finishes fading
    )
      .fromTo(
        firstWords,
        { autoAlpha: 0, y: 75, rotate: 6 },
        { autoAlpha: 1, y: 0, rotate: 0, duration: 0.6, ease: 'power3.out', stagger: 0.09 },
        '<0.2'   // '<' = relative to previous tween's start, +0.2s
      )
      .fromTo(firstDesc, { autoAlpha: 0, y: 50 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out' }, '<0.3')
      .fromTo(firstImg, { autoAlpha: 0, scale: 0.7 }, { autoAlpha: 1, scale: 1, duration: 0.6, ease: 'power3.out' }, '<0.15');

    // Phase 4 — for each following slide: hide the previous one, show the next.
    slides.forEach((s, i) => {
      if (i === 0) return;
      const prev = slides[i - 1];
      const prevWords = prev.querySelectorAll<HTMLElement>('.feature-word');
      const prevDesc = prev.querySelector<HTMLElement>('.feature-desc');
      const prevImg = prev.querySelector<HTMLElement>('.feature-visual img');

      const words = s.querySelectorAll<HTMLElement>('.feature-word');
      const desc = s.querySelector<HTMLElement>('.feature-desc');
      const img = s.querySelector<HTMLElement>('.feature-visual img');

      // Exit animation for the previous slide…
      tl.to(prev, { scale: 0.7, autoAlpha: 0, filter: 'blur(10px)', duration: 0.6, ease: 'power2.in' })
        .to(
          prevWords,
          { y: -70, rotate: -5, autoAlpha: 0, duration: 0.5, ease: 'power2.in', stagger: 0.05 },
          '<0.2'
        )
        .to(prevDesc, { y: -45, autoAlpha: 0, duration: 0.5, ease: 'power2.in' }, '<0.3')
        .to(
          prevImg,
          { scale: 0.6, autoAlpha: 0, duration: 0.5, ease: 'power2.in' },
          '<0.2'
        )
        // …then the entrance animation for the current slide.
        .fromTo(
          s,
          { scale: 0.7, autoAlpha: 0, filter: 'blur(10px)' },
          { scale: 1, autoAlpha: 1, filter: 'blur(0px)', duration: 0.6, ease: 'power2.out' },
          '<0.6'
        )
        .fromTo(
          words,
          { autoAlpha: 0, y: 75, rotate: 6 },
          { autoAlpha: 1, y: 0, rotate: 0, duration: 0.6, ease: 'power3.out', stagger: 0.09 },
          '<0.2'
        )
        .fromTo(desc, { autoAlpha: 0, y: 50 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out' }, '<0.3')
        .fromTo(
          img,
          { autoAlpha: 0, scale: 0.7 },
          { autoAlpha: 1, scale: 1, duration: 0.6, ease: 'power3.out' },
          '<0.15'
        );
    });

    // Phase 5 — exit the LAST slide so the plan section can scroll into view.
    const last = slides[slides.length - 1];
    const lastWords = last.querySelectorAll<HTMLElement>('.feature-word');
    const lastDesc = last.querySelector<HTMLElement>('.feature-desc');
    const lastImg = last.querySelector<HTMLElement>('.feature-visual img');

    tl.to(last, { scale: 0.7, autoAlpha: 0, filter: 'blur(10px)', duration: 0.6, ease: 'power2.in' })
      .to(
        lastWords,
        { y: -70, rotate: -5, autoAlpha: 0, duration: 0.5, ease: 'power2.in', stagger: 0.05 },
        '<0.2'
      )
      .to(lastDesc, { y: -45, autoAlpha: 0, duration: 0.5, ease: 'power2.in' }, '<0.3')
      .to(lastImg, { scale: 0.6, autoAlpha: 0, duration: 0.5, ease: 'power2.in' }, '<0.2');
  }
</script>