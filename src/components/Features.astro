---
import { screens } from '../data/site';
import homeMock from '../assets/mockups/home.png';
import eventMock from '../assets/mockups/event-info.png';
import profileMock from '../assets/mockups/profile.png';
import progressMock from '../assets/mockups/progress.png';

const features = [
  { n: '01', e: '📸', t: 'add stories', d: 'Share what you\'re up to with the people who actually care to see it.', mock: homeMock },
  { n: '02', e: '🎟️', t: 'buy tickets', d: 'Grab event tickets in one tap. Your digital pass lives right in the app.', mock: eventMock },
  { n: '03', e: '🌍', t: 'find clubs & join', d: 'Match with communities, clubs and crews that fit your vibe — join in one tap.', mock: progressMock },
  { n: '04', e: '🤝', t: 'catch up with friends', d: 'See who\'s around, plan a meetup, and actually land in the same room.', mock: profileMock },
];
---

<section id="features" class="relative">
  <div class="feature-intro flex min-h-screen items-center px-5 pt-24 pb-16">
    <div class="mx-auto w-full max-w-[1150px] text-center">
      <h2 class="mx-auto max-w-3xl font-control text-[clamp(30px,4.5vw,56px)] font-medium leading-[1.08] tracking-tight text-whiteout">
        {'Everything your crew needs, in one app — stories, tickets, clubs, and the people you\'d rather not'.split(' ').map((w) => (
          <span class="inline-block overflow-hidden align-top">
            <span class="intro-word intro-lit inline-block will-change-transform text-[#707070]">{w}&nbsp;</span>
          </span>
        ))}
        <span class="inline-block overflow-hidden align-top">
          <span class="intro-word intro-lit inline-block will-change-transform text-[#707070]">
            <span class="font-control-cursive font-normal lowercase text-[#5a708f]">miss.</span>
          </span>
        </span>
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-base font-medium leading-relaxed text-whiteout/60">
        {'Keep scrolling — each one walks through on its own.'.split(' ').map((w) => (
          <span class="inline-block overflow-hidden align-top">
            <span class="intro-word inline-block will-change-transform">{w}&nbsp;</span>
          </span>
        ))}
      </p>
    </div>
  </div>

  <div class="feature-scroll relative">
    <div class="feature-sticky flex min-h-screen items-center overflow-hidden">
      <div class="mx-auto flex w-full max-w-[1150px] items-center px-5">
        {features.map((f) => (
          <div class="feature-slide pointer-events-none absolute inset-x-0 mx-auto w-full max-w-[1150px] px-5">
            <div class="grid items-center gap-10 lg:grid-cols-2">
              <div class="feature-copy order-2 lg:order-1">
                <h3 class="feature-title mt-4 font-control text-[clamp(36px,6vw,80px)] font-medium leading-[1.02] tracking-tight text-whiteout">
                  {f.t.split(' ').map((w) => (
                    <span class="inline-block overflow-hidden align-top">
                      <span class="feature-word inline-block will-change-transform">{w}&nbsp;</span>
                    </span>
                  ))}
                </h3>
                <p class="feature-desc mt-5 max-w-md text-base font-normal leading-relaxed text-whiteout/60">
                  {f.d}
                </p>
              </div>
              <div class="feature-visual order-1 flex justify-center [perspective:1200px] lg:order-2">
                <img
                  src={f.mock.src}
                  alt={f.t}
                  class="w-60 max-w-[50vw] rounded-xl object-cover shadow-[0_30px_80px_rgba(0,0,0,0.5)]"
                />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="relative mx-auto max-w-[1150px] px-5 py-24">
    <div class="reveal grid items-center gap-10 border-t border-whiteout/10 pt-16 lg:grid-cols-2">
      <div>
        <p class="plan-label text-sm font-medium uppercase tracking-[0.12em] text-whiteout/50">the whole plan</p>
        <h3 class="mt-3 font-control text-[clamp(28px,4vw,44px)] font-medium leading-[1.05] tracking-tight text-whiteout">
          {'your ticket,'.split(' ').map((w) => (
            <span class="inline-block overflow-hidden align-top">
              <span class="plan-word inline-block will-change-transform">{w}&nbsp;</span>
            </span>
          ))}
          <span class="inline-block overflow-hidden align-top">
            <span class="plan-word inline-block will-change-transform">
              <span class="font-control-cursive font-normal lowercase text-twilight-blue">your proof.</span>
            </span>
          </span>
        </h3>
        <p class="plan-desc mt-4 max-w-md text-base font-normal leading-relaxed text-whiteout/60">
          Every event you go to gets captured — the ticket, the moment, the people. It becomes a
          wall of everything you've actually done.
        </p>
        <a
          href="#waitlist"
          class="plan-cta btn-glass-yellow mt-6"
        >
          start collecting →
        </a>
      </div>

      <div class="flex justify-center gap-4">
        {screens.slice(0, 3).map((s, i) => (
          <div
            class={`flex w-32 flex-col gap-3 rounded-xl bg-haze p-2.5 ${
              i === 1 ? 'mt-6' : 'mb-6'
            }`}
          >
            <div class="aspect-[9/16] w-full rounded-lg bg-twilight-blue/20"></div>
            <p class="text-xs font-medium leading-tight text-ink">{s.cap}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('.reveal').forEach((el) => {
    gsap.from(el, {
      y: 40,
      opacity: 0,
      duration: 0.9,
      ease: 'power3.out',
      scrollTrigger: { trigger: el, start: 'top 80%', once: true },
    });
  });

  const intro = document.querySelector('.feature-intro');
  const introWords = gsap.utils.toArray('.intro-word');

  if (intro && introWords.length) {
    const lit = gsap.utils.toArray('.intro-lit');
    const wordStep = 0.15;
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: intro,
        start: 'top top',
        end: () => '+=' + window.innerHeight * (lit.length * wordStep + 0.1),
        pin: true,
        scrub: true,
        anticipatePin: 1,
      },
    });

    lit.forEach((w, i) => {
      const inner = w.querySelector('span') || w;
      const target =
        inner.classList.contains('text-[#5a708f]')
          ? '#426188'
          : '#ffffff';
      tl.to(inner, { color: target, duration: wordStep }, i * wordStep);
    });

    tl.to(intro, {
      autoAlpha: 0,
      yPercent: -15,
      duration: wordStep * 0.6,
      ease: 'power2.in',
    });
  }

  gsap.from('.plan-label', {
    y: 30,
    autoAlpha: 0,
    duration: 0.8,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.plan-label', start: 'top 85%', once: true },
  });
  gsap.utils.toArray('.plan-word').forEach((w, i) => {
    gsap.from(w, {
      yPercent: 110,
      autoAlpha: 0,
      rotate: 4,
      duration: 0.9,
      delay: i * 0.08,
      ease: 'power4.out',
      scrollTrigger: { trigger: '.plan-word', start: 'top 85%', once: true },
    });
  });
  gsap.from('.plan-desc, .plan-cta', {
    y: 30,
    autoAlpha: 0,
    duration: 0.8,
    stagger: 0.15,
    ease: 'power3.out',
    scrollTrigger: { trigger: '.plan-desc', start: 'top 88%', once: true },
  });

  const slides = gsap.utils.toArray('.feature-slide');
  const scroller = document.querySelector('.feature-scroll');
  const sticky = document.querySelector('.feature-sticky');

  if (slides.length) {
    slides.forEach((s, i) => {
      const words = s.querySelectorAll('.feature-word');
      const desc = s.querySelector('.feature-desc');
      const img = s.querySelector('.feature-visual img');

      gsap.set(s, { scale: 0.7, autoAlpha: 0, filter: 'blur(10px)' });
      gsap.set(words, { autoAlpha: 0, y: 70, rotate: 5 });
      gsap.set(desc, { autoAlpha: 0, y: 45 });
      gsap.set(img, { autoAlpha: 0, scale: 0.7 });
    });

    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: scroller,
        start: 'top top',
        end: () => '+=' + (slides.length + 1) * window.innerHeight * 1.5,
        pin: sticky,
        scrub: true,
        anticipatePin: 1,
      },
    });

    const first = slides[0];
    const firstWords = first.querySelectorAll('.feature-word');
    const firstDesc = first.querySelector('.feature-desc');
    const firstImg = first.querySelector('.feature-visual img');

    tl.fromTo(
      first,
      { scale: 0.7, autoAlpha: 0, filter: 'blur(10px)' },
      { scale: 1, autoAlpha: 1, filter: 'blur(0px)', duration: 0.6, ease: 'power2.out' }
    )
      .fromTo(
        firstWords,
        { autoAlpha: 0, y: 75, rotate: 6 },
        { autoAlpha: 1, y: 0, rotate: 0, duration: 0.6, ease: 'power3.out', stagger: 0.09 },
        '<0.2'
      )
      .fromTo(firstDesc, { autoAlpha: 0, y: 50 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out' }, '<0.3')
      .fromTo(firstImg, { autoAlpha: 0, scale: 0.7 }, { autoAlpha: 1, scale: 1, duration: 0.6, ease: 'power3.out' }, '<0.15');

    slides.forEach((s, i) => {
      if (i === 0) return;
      const prev = slides[i - 1];
      const prevWords = prev.querySelectorAll('.feature-word');
      const prevDesc = prev.querySelector('.feature-desc');
      const prevImg = prev.querySelector('.feature-visual img');

      const words = s.querySelectorAll('.feature-word');
      const desc = s.querySelector('.feature-desc');
      const img = s.querySelector('.feature-visual img');

      tl.to(prev, { scale: 0.7, autoAlpha: 0, filter: 'blur(10px)', duration: 0.6, ease: 'power2.in' })
        .to(
          prevWords,
          { y: -70, rotate: -5, autoAlpha: 0, duration: 0.5, ease: 'power2.in', stagger: 0.05 },
          '<0.2'
        )
        .to(prevDesc, { y: -45, autoAlpha: 0, duration: 0.5, ease: 'power2.in' }, '<0.3')
        .to(
          prevImg,
          { scale: 0.6, autoAlpha: 0, duration: 0.5, ease: 'power2.in' },
          '<0.2'
        )
        .fromTo(
          s,
          { scale: 0.7, autoAlpha: 0, filter: 'blur(10px)' },
          { scale: 1, autoAlpha: 1, filter: 'blur(0px)', duration: 0.6, ease: 'power2.out' },
          '<0.6'
        )
        .fromTo(
          words,
          { autoAlpha: 0, y: 75, rotate: 6 },
          { autoAlpha: 1, y: 0, rotate: 0, duration: 0.6, ease: 'power3.out', stagger: 0.09 },
          '<0.2'
        )
        .fromTo(desc, { autoAlpha: 0, y: 50 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'power3.out' }, '<0.3')
        .fromTo(
          img,
          { autoAlpha: 0, scale: 0.7 },
          { autoAlpha: 1, scale: 1, duration: 0.6, ease: 'power3.out' },
          '<0.15'
        );
    });

    const last = slides[slides.length - 1];
    const lastWords = last.querySelectorAll('.feature-word');
    const lastDesc = last.querySelector('.feature-desc');
    const lastImg = last.querySelector('.feature-visual img');

    tl.to(last, { scale: 0.7, autoAlpha: 0, filter: 'blur(10px)', duration: 0.6, ease: 'power2.in' })
      .to(
        lastWords,
        { y: -70, rotate: -5, autoAlpha: 0, duration: 0.5, ease: 'power2.in', stagger: 0.05 },
        '<0.2'
      )
      .to(lastDesc, { y: -45, autoAlpha: 0, duration: 0.5, ease: 'power2.in' }, '<0.3')
      .to(lastImg, { scale: 0.6, autoAlpha: 0, duration: 0.5, ease: 'power2.in' }, '<0.2');
  }
</script>