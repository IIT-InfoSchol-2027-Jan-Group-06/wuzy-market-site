---
import Chip from './Chip.astro';
import { slots, clips } from '../data/site';
---
<section class="relative flex min-h-[100svh] items-center overflow-hidden">
  <!-- still swaps now, clip fades over it once a real mp4 is dropped in -->
  <img id="heroStill" src={`/media/hero-${clips[0]}.jpg`} alt="" aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover opacity-45 transition-opacity duration-300" />
  <video id="heroClip" autoplay muted loop playsinline preload="none"
    class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-300"></video>
  <div class="absolute inset-0 bg-gradient-to-b from-void/85 via-void/55 to-void"></div>

  <div class="relative mx-auto w-full max-w-5xl px-5 pt-28">
    <h1 class="font-display text-[clamp(2.2rem,7.5vw,5.5rem)] leading-[1.05] lowercase tracking-tight">
      i want to <Chip name="action" opts={slots[0].opts} /> with <Chip name="count" opts={slots[1].opts} /> people
      near <Chip name="city" opts={slots[2].opts} /> this <Chip name="day" opts={slots[3].opts} />
    </h1>
    <p class="mt-7 max-w-xl text-lg text-mute">Wuzy turns that sentence into a real Saturday. With actual people. Who actually show up.</p>
    <div class="mt-9 flex flex-wrap items-center gap-6">
      <a href="#seat" class="rounded-full bg-butter px-7 py-3.5 font-semibold text-void hover:bg-butter-deep">build this -&gt;</a>
      <a href="#rail" class="text-mute underline underline-offset-4 hover:text-ink">see what's on this week</a>
    </div>
  </div>

  <p class="absolute bottom-6 left-5 font-mono text-[11px] tracking-widest text-butter-dim">
    COLOMBO / 6.9271 N / 79.8612 E / <span id="clock">--:--</span> IST
  </p>
</section>

<script>
  import { clips } from '../data/site';
  const still = document.getElementById('heroStill') as HTMLImageElement;
  const clip = document.getElementById('heroClip') as HTMLVideoElement;

  clip.addEventListener('canplay', () => { clip.style.opacity = '0.45'; });
  clip.addEventListener('error', () => { clip.style.opacity = '0'; });

  const setClip = (i: number) => {
    still.style.opacity = '0';
    clip.style.opacity = '0';
    setTimeout(() => {
      still.src = `/media/hero-${clips[i]}.jpg`;
      still.style.opacity = '0.45';
      clip.src = `/media/hero-${clips[i]}.mp4`;
      clip.load();
    }, 220);
  };

  document.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach(c => {
    const opts = JSON.parse(c.dataset.opts!);
    let i = 0;
    c.addEventListener('click', () => {
      i = (i + 1) % opts.length;
      c.textContent = opts[i];
      c.setAttribute('aria-label', `change ${c.dataset.chip}, currently ${opts[i]}`);
      if (c.dataset.chip === 'action') setClip(i);
    });
  });

  const tick = () => {
    const t = new Date().toLocaleTimeString('en-GB', { timeZone: 'Asia/Colombo', hour: '2-digit', minute: '2-digit' });
    document.getElementById('clock')!.textContent = t;
  };
  tick(); setInterval(tick, 30000);
</script>
