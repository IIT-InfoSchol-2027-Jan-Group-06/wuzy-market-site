---
import '../styles/global.css'
import NavBar from '../components/NavBar.astro'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" type="image/png" href="/favicon.png?v=2" />

		<title>Wuzy</title>
		<meta
			name="description"
			content="Wuzy matches you with like-minded people, communities, and verified events, so you always show up with your crowd."
		/>

		<meta property="og:type" content="website" />
		<meta property="og:title" content="Wuzy — every connection has a story." />
		<meta
			property="og:description"
			content="Events, tickets, communities, and the connections you don't want to miss — all in one app."
		/>
		<meta name="twitter:card" content="summary_large_image" />
	</head>
	<body class="page-grad min-h-screen text-charcoal">
		<NavBar/>
		<main class="relative">
			<slot />
		</main>

		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			// Three sections are pinned, and their pin-spacers add roughly
			// seventeen viewports of document height — but only once the deferred
			// module scripts have run. The browser resolves `location.hash` and
			// restores a saved scroll offset well before that, against a document
			// that short, so /#pricing and a mid-page reload both used to dump the
			// reader into the middle of the feature slideshow.
			history.scrollRestoration = 'manual';

			window.addEventListener('load', () => {
				// Make sure every spacer is measured and final before we look up
				// where the target actually sits.
				ScrollTrigger.refresh();

				const id = decodeURIComponent(location.hash.slice(1));
				if (!id) return;

				requestAnimationFrame(() => {
					document.getElementById(id)?.scrollIntoView();
				});
			});
		</script>
	</body>
</html>